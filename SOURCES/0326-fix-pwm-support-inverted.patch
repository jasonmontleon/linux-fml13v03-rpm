-	clk_disable_unprepare(dwc->clk);
-	reset_control_assert(dwc->rst);
+	dwc_pwm_cleanup(pdev);
 
 	return 0;
 }
 
+static void dwc_pwm_shutdown(struct platform_device *pdev)
+{
+	dwc_pwm_cleanup(pdev);
+}
