From 5c1ffac59c923cfd4aaa209440487615a655993d Mon Sep 17 00:00:00 2001
From: ouyanghui <ouyanghui@eswincomputing.com>
Date: Fri, 29 Aug 2025 11:16:06 +0800
Subject: [PATCH 517/540] fix:cpu frequency switching cause d2d protocol error

Changelogs:
1. add cpu aclk mux table, mux_u_cpu_aclk_2mux1_gfree.
2. add the switching process for u84_aclk and u84_busclk.
3. modify cpu-supported frequency
4. modify spll0_fout2 freq 1600MHz
5. split the opptable into eic7700-opptable.dtsi and eic7702-opptable.dtsi

Signed-off-by: ouyanghui <ouyanghui@eswincomputing.com>
---
 .../dts/eswin/eic7702-som560-interleave.dtsi  | 96 +++++--------------
 1 file changed, 25 insertions(+), 71 deletions(-)

diff --git a/arch/riscv/boot/dts/eswin/eic7702-som560-interleave.dtsi b/arch/riscv/boot/dts/eswin/eic7702-som560-interleave.dtsi
index 7b7b129bd0f5..dcec16c4d27b 100644
--- a/arch/riscv/boot/dts/eswin/eic7702-som560-interleave.dtsi
+++ b/arch/riscv/boot/dts/eswin/eic7702-som560-interleave.dtsi
@@ -507,7 +507,7 @@ &gpu0 {
 	status = "okay";
 };
 &d1_gpu {
-	status = "okay";
+	status = "disabled";
 };
 
 &gc820 {
@@ -719,59 +719,35 @@ &d1_graphcard2 {
 	status = "disabled";
 };
 
-&isp_0 {
-	status = "okay";
-};
