 	{2304, 8000, 18432000, 0x40, 0x02, 0x10, 0x35, 0x0A, 0x1B, 0x1F, 0x5F},
 	{3072, 8000, 24576000, 0x60, 0x02, 0x10, 0x35, 0x0A, 0x1B, 0x1F, 0x7F},
 	{3250, 8000, 26000000, 0x0C, 0x18, 0x0F, 0x2D, 0x0A, 0x0A, 0x27, 0x27},
-
 };
 
 static inline int get_coeff(int mclk, int rate)
@@ -351,6 +354,21 @@ static int es8326_pcm_hw_params(struct snd_pcm_substream *substream,
 	u8 srate = 0;
 	int coeff;
 
+#ifdef ESWIN_CONFIG_CODEC_ES8326
+	switch (params_rate(params)) {
+	case 8000:
+		es8326->sysclk = params_rate(params) * 1024;
+		break;
+	case 16000:
+		es8326->sysclk = params_rate(params) * 512;
+		break;
+	default:
+		es8326->sysclk = params_rate(params) * 256;
+		break;
+	}
+	dev_dbg(component->dev, "Setting sysclk %u Hz\n", es8326->sysclk);
+#endif
+
 	coeff = get_coeff(es8326->sysclk, params_rate(params));
 	/* bit size */
 	switch (params_format(params)) {
@@ -1045,7 +1063,7 @@ static int es8326_i2c_probe(struct i2c_client *i2c)
 	if (!es8326)
 		return -ENOMEM;
 
-#ifdef STARFIVE_CONFIG_CODEC_ES8326
+#ifdef ESWIN_CONFIG_CODEC_ES8326
 	es8326->jack = devm_kzalloc(&i2c->dev, sizeof(struct snd_soc_jack),
 				    GFP_KERNEL);
 	if (!es8326->jack)
diff --git a/sound/soc/eswin/esw-dma.c b/sound/soc/eswin/esw-dma.c
