From dabac5695b2f6e612a445021a73b87fe8d90dbea Mon Sep 17 00:00:00 2001
From: "yang.wang" <yang.wang@deepcomputing.io>
Date: Wed, 19 Mar 2025 15:37:56 +0800
Subject: [PATCH 259/540] Add support for the light sensor drivers CM32181 and
 CM32183.

Signed-off-by: yang.wang <yang.wang@deepcomputing.io>
---
 .../eswin/eic7702-deepcomputing-fml13v03.dts  | 68 +++++++++++++++----
 arch/riscv/configs/fml13v03_defconfig         |  4 +-
 drivers/iio/light/cm32181.c                   |  4 +-
 3 files changed, 59 insertions(+), 17 deletions(-)

diff --git a/arch/riscv/boot/dts/eswin/eic7702-deepcomputing-fml13v03.dts b/arch/riscv/boot/dts/eswin/eic7702-deepcomputing-fml13v03.dts
index d1bf7a0ce1ac0..3299476557c4c 100644
--- a/arch/riscv/boot/dts/eswin/eic7702-deepcomputing-fml13v03.dts
+++ b/arch/riscv/boot/dts/eswin/eic7702-deepcomputing-fml13v03.dts
@@ -202,6 +202,19 @@ backlight: backlight {
             250 251 252 253 254>;
         default-brightness-level = <128>;
 	};
+
+    camera_light_power: regulator-gpio69 {
+        compatible = "regulator-fixed";
+        regulator-name = "camera-light-power";
+        regulator-min-microvolt = <1800000>;
+        regulator-max-microvolt = <1800000>;
+        gpio = <&d1_portc 5 GPIO_ACTIVE_HIGH>;
+        enable-active-high;
+        pinctrl-names = "default";
+        pinctrl-0 = <&pinctrl_die1_gpio69_default>;
+        regulator-always-on;
+        status = "okay";
+    };
 };
 
 &D1CACHE {
@@ -1282,20 +1295,33 @@ d1_npu_vcc: npu_svcc {
 };
 
 &d0_i2c2 {
-	/* touch pad*/
-	status = "ok";
-	d0_touchpad: hid@2c {
-		compatible = "hid-over-i2c";
-		reg = <0x2c>;
-		hid-descr-addr = <0x0020>;
-		post-power-on-delay-ms = <200>;
-		interrupt-parent = <&porta>;
-		interrupts = <20 IRQ_TYPE_LEVEL_LOW>;
-		pinctrl-names = "default";
-		pinctrl-0 = <&pinctrl_die0_gpio20_default>;
-		irq-gpios = <&porta 20 GPIO_ACTIVE_LOW>;
-		status = "okay";
-        };
+    status = "ok";
+
+    d0_touchpad: hid@2c {
+        /* touch pad*/
+        compatible = "hid-over-i2c";
+        reg = <0x2c>;
+        hid-descr-addr = <0x0020>;
+        post-power-on-delay-ms = <200>;
+        interrupt-parent = <&porta>;
+        interrupts = <20 IRQ_TYPE_LEVEL_LOW>;
+        pinctrl-names = "default";
+        pinctrl-0 = <&pinctrl_die0_gpio20_default>;
+        irq-gpios = <&porta 20 GPIO_ACTIVE_LOW>;
+        status = "okay";
+    };
+
+    cm32181_sensor: cm32181@10 {
+        compatible = "capella,cm32181";
+        reg = <0x10>;
+        status = "okay";
+    };
+
+    cm32183_sensor: cm32183@29 {
+        compatible = "capella,cm32183";
+        reg = <0x29>;
+        status = "okay";
+    };
 };
 
 &d1_i2c2 {
@@ -1567,6 +1593,20 @@ &d1_d2d {
 	status = "okay";
 };
 
+&pinctrl_die1_gpio69_default {
+    mux {
+        groups = "gpio69_group";
+        function = "gpio69_func";
+    };
+    conf {
+        groups = "gpio69_group";
+        drive-strength = <2>;
+        output-high;
+        bias-pull-up = <1>;
+        bias-pull-down = <0>;
+    };
+};
+
 /* die0 GPIO Function Description
 
 	gpio0   : pcie prstn(I)
diff --git a/arch/riscv/configs/fml13v03_defconfig b/arch/riscv/configs/fml13v03_defconfig
index 1c3e14d9a251d..9d0e62125f2bc 100755
--- a/arch/riscv/configs/fml13v03_defconfig
+++ b/arch/riscv/configs/fml13v03_defconfig
@@ -1,5 +1,3 @@
-CONFIG_LOCALVERSION="-eic7702"
-# CONFIG_LOCALVERSION_AUTO is not set
 CONFIG_SYSVIPC=y
 CONFIG_POSIX_MQUEUE=y
 CONFIG_WATCH_QUEUE=y
@@ -788,6 +786,8 @@ CONFIG_ESWIN_MMZ_VB=y
 CONFIG_ESWIN_DEV_DMA_BUF=y
 CONFIG_ESWIN_IOMMU_RSV=y
 CONFIG_ESWIN_DMA_MEMCP=y
+CONFIG_IIO=y
+CONFIG_CM32181=y
 CONFIG_PWM=y
 CONFIG_PWM_ESWIN=y
 CONFIG_RESET_ESWIN=y
diff --git a/drivers/iio/light/cm32181.c b/drivers/iio/light/cm32181.c
index 9df85b3999fa8..f9d0a79bd5618 100644
--- a/drivers/iio/light/cm32181.c
+++ b/drivers/iio/light/cm32181.c
@@ -201,6 +201,7 @@ static int cm32181_reg_init(struct cm32181_chip *cm32181)
 		break;
 	case 0x81: /* CM32181 */
 	case 0x82: /* CM32182, fully compat. with CM32181 */
+	case 0x83:
 		cm32181->num_als_it = ARRAY_SIZE(cm32181_als_it_bits);
 		cm32181->als_it_bits = cm32181_als_it_bits;
 		cm32181->als_it_values = cm32181_als_it_values;
@@ -523,7 +524,8 @@ static DEFINE_SIMPLE_DEV_PM_OPS(cm32181_pm_ops, cm32181_suspend, cm32181_resume)
 static const struct of_device_id cm32181_of_match[] = {
 	{ .compatible = "capella,cm3218" },
 	{ .compatible = "capella,cm32181" },
-	{ }
+	{ .compatible = "capella,cm32183" },
+	{}
 };
 MODULE_DEVICE_TABLE(of, cm32181_of_match);
 
-- 
2.53.0

