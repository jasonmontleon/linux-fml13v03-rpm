From e048c9f3f8f5039f350cb68f1ae266c6df16e4da Mon Sep 17 00:00:00 2001
From: Xiang Xu <xuxiang@eswincomputing.com>
Date: Fri, 12 Sep 2025 17:04:41 +0800
Subject: [PATCH 513/533] refactor:refactor bootspi driver

Changelogs:
1.refactor bootspi driver
2. support eic7702 board

Signed-off-by: Xiang Xu <xuxiang@eswincomputing.com>
---
 arch/riscv/boot/dts/eswin/d560-ep-evb.dts  | 4 ----
 arch/riscv/boot/dts/eswin/eic7700-ce1.dtsi | 2 --
 2 files changed, 6 deletions(-)

diff --git a/arch/riscv/boot/dts/eswin/d560-ep-evb.dts b/arch/riscv/boot/dts/eswin/d560-ep-evb.dts
index 5828b9f175f6..e03847daf4d3 100644
--- a/arch/riscv/boot/dts/eswin/d560-ep-evb.dts
+++ b/arch/riscv/boot/dts/eswin/d560-ep-evb.dts
@@ -1241,8 +1241,6 @@ &bootspi {
 	/* spi flash */
 	status = "okay";
 	num-cs = <1>;
-	cs-gpios = <&portd 0 GPIO_ACTIVE_LOW>;
-	wp-gpios = <&portd 4 GPIO_ACTIVE_LOW>;
 	spi-flash@0 {
 		compatible = "winbond,w25q128jw",
 					"jedec,spi-nor";
@@ -1258,8 +1256,6 @@ &d1_bootspi {
 	/* spi flash */
 	status = "disabled";
 	num-cs = <1>;
-	cs-gpios = <&d1_portd 0 GPIO_ACTIVE_LOW>;
-	wp-gpios = <&d1_portd 4 GPIO_ACTIVE_LOW>;
 	spi-flash@0 {
 		compatible = "winbond,w25q128jw",
 					"jedec,spi-nor";
diff --git a/arch/riscv/boot/dts/eswin/eic7700-ce1.dtsi b/arch/riscv/boot/dts/eswin/eic7700-ce1.dtsi
index d025773aa21d..68477151be26 100644
--- a/arch/riscv/boot/dts/eswin/eic7700-ce1.dtsi
+++ b/arch/riscv/boot/dts/eswin/eic7700-ce1.dtsi
@@ -599,8 +599,6 @@ &bootspi {
 	/* spi flash */
 	status = "okay";
 	num-cs = <1>;
-	cs-gpios = <&portd 0 GPIO_ACTIVE_LOW>;
-	wp-gpios = <&portd 4 GPIO_ACTIVE_LOW>;
 	spi-flash@0 {
 		compatible = "winbond,w25q64jw",
 					"jedec,spi-nor";
-- 
2.52.0

