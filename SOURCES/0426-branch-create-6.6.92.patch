-static inline u32 es_dvp2axi_scl_ctl(struct es_dvp2axi_stream *stream)
-{
-	u32 fmt_type = stream->dvp2axi_fmt_in->fmt_type;
-	return (fmt_type == DVP2AXI_FMT_TYPE_YUV) ? ENABLE_YUV_16BIT_BYPASS :
-						ENABLE_RAW_16BIT_BYPASS;
