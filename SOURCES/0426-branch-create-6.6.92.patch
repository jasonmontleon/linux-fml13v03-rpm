-	pixm = &scale_vdev->pixm;
-	dvp2axi_fmt = scale_vdev->scale_out_fmt;
-	*num_planes = dvp2axi_fmt->mplanes;
-
-	for (i = 0; i < dvp2axi_fmt->mplanes; i++) {
-		plane_fmt = &pixm->plane_fmt[i];
