+
+#ifndef __LT6911UXE_H
+#define __LT6911UXE_H
+
+#include <linux/types.h>
+
+#define LT6911UXE_NAME             "lt6911uxe"
+
+struct lt6911uxe_platform_data {
+	unsigned int port;
+	unsigned int lanes;
+	uint32_t i2c_slave_address;
+	int irq_pin;
+	unsigned int irq_pin_flags;
+	char irq_pin_name[16];
