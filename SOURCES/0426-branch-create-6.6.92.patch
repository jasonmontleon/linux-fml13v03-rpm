-			       bool is_multi_input)
-{
-	struct es_dvp2axi_scale_vdev *scale_vdev;
-	int i, j, ret;
-
-	for (i = 0; i < stream_num; i++) {
-		scale_vdev = &dvp2axi_dev->scale_vdev[i];
