-		buf = list_first_entry(&luma_vdev->stat,
-				       struct es_dvp2axi_buffer, queue);
-		list_del(&buf->queue);
-		vb2_buffer_done(&buf->vb.vb2_buf, VB2_BUF_STATE_ERROR);
-	}
-	spin_unlock_bh(&luma_vdev->rd_lock);
-}
