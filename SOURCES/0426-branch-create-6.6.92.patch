-static void es_dvp2axi_unregister_scale_vdev(struct es_dvp2axi_scale_vdev *scale_vdev)
-{
-	struct es_dvp2axi_vdev_node *node = &scale_vdev->vnode;
-	struct video_device *vdev = &node->vdev;
