-	if (on && atomic_inc_return(&priv->stream_cnt) > 1)
-		return 0;
-
-	if (dvp2axi_dev->chip_id >= CHIP_EIC770X_DVP2AXI) {
-		if (priv->mode.rdbk_mode == ESISP_VICAP_RDBK_AIQ)
