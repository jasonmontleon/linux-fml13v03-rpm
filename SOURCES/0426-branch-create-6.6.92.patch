-			es_dvp2axi_stream_resume(dvp2axi_dev, ES_DVP2AXI_RESUME_ISP);
-		} else {
-			if (priv->toisp_inf.link_mode == TOISP0) {
-				sditf_channel_disable(priv, 0);
-			} else if (priv->toisp_inf.link_mode == TOISP1) {
