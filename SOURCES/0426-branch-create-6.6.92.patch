+static int check_dev_idle(struct hantrovcmd_dev *dev) {
+	int idle = 0;
+	unsigned long flags;
+	u32 exe_cmdbuf_cnt = 0xffffffff;
+	u32 rdy_cmdbuf_cnt = 0xffffffff;
