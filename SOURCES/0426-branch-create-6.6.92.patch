-
-		udelay(5);
-	}
-
-	for (i = 0; i < ARRAY_SIZE(dvp2axi_hw->dvp2axi_rst); i++)
-		if (dvp2axi_hw->dvp2axi_rst[i])
-			reset_control_assert(dvp2axi_hw->dvp2axi_rst[i]);
-
-	udelay(10);
-
-	for (i = 0; i < ARRAY_SIZE(dvp2axi_hw->dvp2axi_rst); i++)
-		if (dvp2axi_hw->dvp2axi_rst[i])
-			reset_control_deassert(dvp2axi_hw->dvp2axi_rst[i]);
