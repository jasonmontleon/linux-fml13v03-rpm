-	if (dvp2axi_dev->inf_id == ES_DVP2AXI_DVP)
-		scale_vdev->ch_src = SCALE_DVP;
-	else
-		scale_vdev->ch_src = 4 * dvp2axi_dev->csi_host_idx + scale_vdev->ch;
-	ch_info->width = pixm.width;
-	ch_info->height = pixm.height;
