+static int lt6911uxe_csi_enable(struct v4l2_subdev *sd, bool enable)
+{
+	if (enable)
+		lt6911uxe_i2c_wr8(sd, REG_MIPI_TX_CTRL, 0x01);
+	else
+		lt6911uxe_i2c_wr8(sd, REG_MIPI_TX_CTRL, 0x00);
+	return 0;
+}
