-	struct v4l2_subdev_frame_interval fi;
-	int ret;
-
-	if (fival->index != 0)
-		return -EINVAL;
-
-	if (!sensor || !sensor->sd) {
-		/* TODO: active_sensor is NULL if using DMARX path */
-		v4l2_err(&dev->v4l2_dev, "%s Not active sensor\n", __func__);
