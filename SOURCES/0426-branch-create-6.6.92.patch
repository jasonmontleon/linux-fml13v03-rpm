+	lt6911uxe->link_freq = v4l2_ctrl_new_int_menu(ctrl_hdlr, NULL,
+			V4L2_CID_LINK_FREQ,
+			ARRAY_SIZE(link_freq_menu_items) - 1, 0,
+			link_freq_menu_items);
