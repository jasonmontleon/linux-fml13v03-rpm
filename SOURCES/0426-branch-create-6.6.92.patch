+	gpio77  : lora nreset(O)
+	gpio79  : m2 power on(O)
+	gpio80  : lora ctrl2(O)
+	gpio81  : lora ctrl1(O)
+	gpio92  : touch rstn(O)
+	gpio93  : 5g reset(O)
+*/
