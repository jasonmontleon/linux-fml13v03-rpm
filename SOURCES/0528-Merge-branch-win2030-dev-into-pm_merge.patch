+ * HDR_COMPR: linearised and compressed data for hdr
+ */
+enum esmodule_hdr_mode {
+    NO_HDR = 0,
+    HDR_X2 = 1,
+    HDR_X3 = 2,
+    HDR_COMPR,
+};
+
+enum esmodule_hdr_compr_segment {
