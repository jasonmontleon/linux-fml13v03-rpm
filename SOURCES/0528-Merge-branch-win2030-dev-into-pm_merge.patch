-#define PROC_PARSE_ERROR        0x02
-
-#define PROC_PRINT_STAT(stat, sfile, name) \
-    seq_printf(sfile, "|%-32s|%-16d|\n", #name, stat.name); \
-    seq_printf(sfile, "|--------------------------------|----------------|\n");
-
-
-enum {
-    PROC_CMD_RW,
-    PROC_CMD_CLEAR
-};
