+static void lt6911uxe_reset(struct lt6911uxe *lt6911uxe)
+{
+	gpiod_set_value(lt6911uxe->reset_gpio, 1);
+	usleep_range(2000, 2100);
+	gpiod_set_value(lt6911uxe->reset_gpio, 0);
+	usleep_range(120*1000, 121*1000);
