+static inline u32 eswin_pci_phys_mem_get_id(const char *name)
+{
+	u32 idx;
+	if (sscanf(name, "pci_phys_mem_%u", &idx) != 1) {
+		pr_err_once("wrong pci_phys_mem name %s\n", name);
