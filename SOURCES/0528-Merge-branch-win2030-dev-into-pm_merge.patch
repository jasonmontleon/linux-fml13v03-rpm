+static int imx415_find_mode(u64 lane_rate, u32 hdr_mode)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(supported_modes); i++) {
+		if (supported_modes[i].lane_rate == lane_rate &&
