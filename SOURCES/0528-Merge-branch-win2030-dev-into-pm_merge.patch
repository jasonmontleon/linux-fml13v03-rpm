-int vvcam_soc_irq_init(struct platform_device *pdev, struct vvcam_soc_dev *soc_dev)
-{
-	int i;
-
-	for (i = 0; i < 8; i++) {
-		int ret;
-
-		soc_dev->dvp2axi_irqnum[i] = platform_get_irq(pdev, i);
-		soc_dev->dvp2axi_intrid[i] = i;
