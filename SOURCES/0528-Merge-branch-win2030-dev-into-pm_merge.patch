+
 	rsvmem_heap->heap = eswin_heap_add(&exp_info);
 	if (IS_ERR(rsvmem_heap->heap)) {
 		int ret = PTR_ERR(rsvmem_heap->heap);
@@ -570,14 +848,16 @@ static int __add_eswin_rsvmem_heap(struct mem_block *memblock, void *data)
