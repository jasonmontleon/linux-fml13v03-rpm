+#ifdef CONFIG_COMPAT
+static long lt6911uxe_compat_ioctl32(struct v4l2_subdev *sd,
+				  unsigned int cmd, unsigned long arg)
+{
+	void __user *up = compat_ptr(arg);
+	struct esmodule_inf *inf;
+	long ret;
