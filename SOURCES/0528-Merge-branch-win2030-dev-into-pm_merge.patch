-int vvcam_mipi_reset(struct vvcam_mipi_dev *mipi_dev, uint32_t val)
-{
-    uint32_t tpg_reg = 0;
-
-    tpg_reg = vvcam_mipi_read_reg(mipi_dev->tpg_reg, 0);
-
-    if (val) {
-        /* reset */
-        tpg_reg &= ~TPG_CSI_RST_MASK;
-    } else {
-        /* unreset */
-        tpg_reg |= TPG_CSI_RST_MASK;
-    }
