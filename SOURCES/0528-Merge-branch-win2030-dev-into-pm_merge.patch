+	lt6911_i2c_dbg("==>%s \n", __func__);
+
+	if (buf == NULL)
+		return -1;
+
+	ret = lt6911_i2c_write_byte(LT6911_I2C_SWITCH_BANK_REG, LT6911_I2C_VERSION_BANK_REG);
