-void dw_dphy_write_msk(struct dw_dphy_rx *dev, u32 address, u32 data, u8 shift,
-		       u8 width)
-{
-	u32 temp = dw_dphy_read(dev, address);
-	u32 mask = (1 << width) - 1;
-
-	temp &= ~(mask << shift);
-	temp |= (data & mask) << shift;
-	dw_dphy_write(dev, address, temp);
-}
