-#define IPI_DATA_TYPE_YUV420_8BIT_LEG       0x1A
-#define IPI_DATA_TYPE_YUV420_8BIT_CSPS      0x1C
-#define IPI_DATA_TYPE_YUV420_10BIT_CSPS     0x1D
-#define IPI_DATA_TYPE_YUV422_8BIT           0x1E
