-
-    vi_fh = file->private_data;
-    vi_dev = vi_fh->vi_dev;
-
-    vma->vm_page_prot = pgprot_noncached(vma->vm_page_prot);
-
-    return vm_iomap_memory(vma, vi_dev->paddr, vi_dev->regs_size);
-}
-
