+
+&d1_i2c0 {
+	/* power monitor(ina236) */
+	status = "okay";
+	ina226@45 {
+		compatible = "ti,ina226";
+		#io-channel-cells = <1>;
+		label = "cpu_vdd";
+		reg = <0x45>;
+		shunt-resistor = <1000>;
+	};
+};
+
+&fan_control {
+	status = "okay";
+};
+
