From ee11c0d7e991d131d2eb7e8d096792451b799f28 Mon Sep 17 00:00:00 2001
From: cheney <11722200@qq.com>
Date: Tue, 1 Jul 2025 15:26:22 +0800
Subject: [PATCH 405/533] Add FML13V03 support: DTS, sound, and more

---
 .../boot/dts/eswin/eic7702-deepcomputing-fml13v03.dts    | 2 +-
 arch/riscv/configs/fml13v03_defconfig                    | 9 +++++++++
 2 files changed, 10 insertions(+), 1 deletion(-)

diff --git a/arch/riscv/boot/dts/eswin/eic7702-deepcomputing-fml13v03.dts b/arch/riscv/boot/dts/eswin/eic7702-deepcomputing-fml13v03.dts
index 910a1505f414..98d2a3769173 100644
--- a/arch/riscv/boot/dts/eswin/eic7702-deepcomputing-fml13v03.dts
+++ b/arch/riscv/boot/dts/eswin/eic7702-deepcomputing-fml13v03.dts
@@ -1569,7 +1569,7 @@ &pwm0 {
 	pinctrl-names = "default", "sleep";
 	pinctrl-0 = <&pinctrl_die0_pwm0_default>;
 	pinctrl-1 = <&pinctrl_die0_gpio68_default>;
-	enable-gpios = <&portc 4 GPIO_ACTIVE_HIGH>;
+	fan-gpios = <&portc 4 GPIO_ACTIVE_HIGH>;
 };
 
 &d1_pwm0 {
diff --git a/arch/riscv/configs/fml13v03_defconfig b/arch/riscv/configs/fml13v03_defconfig
index f785a5367bbb..01e5dd571fad 100755
--- a/arch/riscv/configs/fml13v03_defconfig
+++ b/arch/riscv/configs/fml13v03_defconfig
@@ -3735,6 +3735,7 @@ CONFIG_TIMER_ESWIN=y
 CONFIG_MAILBOX=y
 CONFIG_ESWIN_MBOX=y
 CONFIG_ESWIN_LPCPU=y
+CONFIG_ESWIN_MALLOC_DMABUF=y
 CONFIG_ARM_SMMU_V3=y
 CONFIG_RPMSG_CHAR=m
 CONFIG_RPMSG_CTRL=m
@@ -4437,3 +4438,11 @@ CONFIG_TEST_BLACKHOLE_DEV=m
 CONFIG_MEMTEST=y
 CONFIG_BCMDHD=m
 CONFIG_BCMDHD_SDIO_IRQ=y
+CONFIG_REGULATOR=y
+CONFIG_REGULATOR_FIXED_VOLTAGE=y
+CONFIG_BCMDHD_FW_PATH="/lib/firmware/fw_bcm43456c5_ag.bin"
+CONFIG_BCMDHD_NVRAM_PATH="/lib/firmware/nvram_ap6256.txt"
+CONFIG_BCMDHD_CLM_PATH="/lib/firmware/clm_bcm43752a2_ag.blob"
+CONFIG_VIDEO_ESWIN_VI_TOP=y
+CONFIG_VIDEO_ESWIN_DVP2AXI=y
+
