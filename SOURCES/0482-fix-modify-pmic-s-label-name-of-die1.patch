From f7f03591d126663393ad04ab7099063a52368912 Mon Sep 17 00:00:00 2001
From: ningyu <ningyu@eswincomputing.com>
Date: Thu, 28 Aug 2025 19:08:22 +0800
Subject: [PATCH 482/533] fix:modify pmic's label name of die1

Changelogs:
Chnage pmic's label name of die1 to d1_npu_vdd

Signed-off-by: ningyu <ningyu@eswincomputing.com>
---
 arch/riscv/boot/dts/eswin/eic7702-d560a.dts | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/arch/riscv/boot/dts/eswin/eic7702-d560a.dts b/arch/riscv/boot/dts/eswin/eic7702-d560a.dts
index b5af295df905..d189592c2771 100644
--- a/arch/riscv/boot/dts/eswin/eic7702-d560a.dts
+++ b/arch/riscv/boot/dts/eswin/eic7702-d560a.dts
@@ -68,7 +68,7 @@ es5340@f {
 		reg = <0xf>;
 		eswin,regulator_default-microvolt=<1000000>;
 		eswin,regulator_label = "supply vdd1", "npu vdd1", "npu current1", "npu temperature1";
-		label = "npu_vdd";
+		label = "d1_npu_vdd";
 		regulators{
 			d1_npu_vcc:npu_svcc{
 				regulator-name="NPU_SVCC_D1";
