From efdc6cc1e76cd16a8a06f9dcbad779f8a61e547b Mon Sep 17 00:00:00 2001
From: hehuan1 <hehuan1@eswincomputing.com>
Date: Thu, 10 Jul 2025 11:21:50 +0800
Subject: [PATCH 469/540] perf: optimize pvt display info

    Changelogs:
    optimize pvt display info

Signed-off-by: hehuan1 <hehuan1@eswincomputing.com>
---
 drivers/hwmon/eswin_dummy_pvt.c | 87 +++++++++++++++++++++++---------
 drivers/hwmon/eswin_pvt.c       | 89 ++++++++++++++++++++++++++++-----
 drivers/hwmon/eswin_pvt.h       |  2 +
 3 files changed, 141 insertions(+), 37 deletions(-)

diff --git a/drivers/hwmon/eswin_dummy_pvt.c b/drivers/hwmon/eswin_dummy_pvt.c
index d4d9c46de910d..8e548b273a61f 100644
--- a/drivers/hwmon/eswin_dummy_pvt.c
+++ b/drivers/hwmon/eswin_dummy_pvt.c
@@ -46,26 +46,29 @@
 #include  <linux/mfd/syscon.h>
 #include <linux/of.h>
 
-
 /*
  * For the sake of the code simplification we created the sensors info table
  * with the sensor names, activation modes, threshold registers base address
  * and the thresholds bit fields.
  */
-static const struct pvt_sensor_info pvt_info_cpu[] = {
-	PVT_SENSOR_INFO(0, "SoC Temperature", hwmon_temp, TEMP, TTHRES),
-	PVT_SENSOR_INFO(0, "SoC Voltage", hwmon_in, VOLT, VTHRES),
-	PVT_SENSOR_INFO(1, "SoC Low-Vt", hwmon_in, LVT, LTHRES),
-	PVT_SENSOR_INFO(2, "SoC UltraLow-Vt", hwmon_in, ULVT, ULTHRES),
-	PVT_SENSOR_INFO(3, "SoC Standard-Vt", hwmon_in, SVT, STHRES),
+static const struct pvt_sensor_info pvt_info_cpu_d0[] = {
+	PVT_SENSOR_INFO(0, "D0 SoC Temperature", hwmon_temp, TEMP, TTHRES),
+	PVT_SENSOR_INFO(0, "D0 SoC Voltage", hwmon_in, VOLT, VTHRES),
+};
+
+static const struct pvt_sensor_info pvt_info_ddr_d0[] = {
+	PVT_SENSOR_INFO(0, "D0 DDR Core Temperature", hwmon_temp, TEMP, TTHRES),
+	PVT_SENSOR_INFO(0, "D0 DDR Core Voltage", hwmon_in, VOLT, VTHRES),
 };
 
-static const struct pvt_sensor_info pvt_info_ddr[] = {
-	PVT_SENSOR_INFO(0, "DDR Core Temperature", hwmon_temp, TEMP, TTHRES),
-	PVT_SENSOR_INFO(0, "DDR Core Voltage", hwmon_in, VOLT, VTHRES),
-	PVT_SENSOR_INFO(1, "DDR Core Low-Vt", hwmon_in, LVT, LTHRES),
-	PVT_SENSOR_INFO(2, "DDR Core UltraLow-Vt", hwmon_in, ULVT, ULTHRES),
-	PVT_SENSOR_INFO(3, "DDR Core Standard-Vt", hwmon_in, SVT, STHRES),
+static const struct pvt_sensor_info pvt_info_cpu_d1[] = {
+	PVT_SENSOR_INFO(0, "D1 SoC Temperature", hwmon_temp, TEMP, TTHRES),
+	PVT_SENSOR_INFO(0, "D1 SoC Voltage", hwmon_in, VOLT, VTHRES),
+};
+
+static const struct pvt_sensor_info pvt_info_ddr_d1[] = {
+	PVT_SENSOR_INFO(0, "D1 DDR Core Temperature", hwmon_temp, TEMP, TTHRES),
+	PVT_SENSOR_INFO(0, "D1 DDR Core Voltage", hwmon_in, VOLT, VTHRES),
 };
 
 /*
@@ -215,9 +218,8 @@ static int eswin_pvt_read_data(struct pvt_hwmon *pvt, enum pvt_sensor_type type,
 {
 	u32 data;
 	u32 offset;
-	const struct pvt_sensor_info *pvt_info;
+	const struct pvt_sensor_info *pvt_info = pvt->sensor_info;
 
-	pvt_info = of_device_get_match_data(pvt->dev);
 	if (!pvt_info) {
 		dev_err(pvt->dev, "No matching device data found\n");
 		return -EINVAL;
@@ -504,12 +506,11 @@ static int eswin_pvt_hwmon_read_string(struct device *dev,
 {
 	struct pvt_hwmon *pvt = dev_get_drvdata(dev);
 
-	const struct pvt_sensor_info *pvt_info;
+	const struct pvt_sensor_info *pvt_info = pvt->sensor_info;
 
 	if (!eswin_pvt_hwmon_channel_is_valid(type, ch))
 		return -EINVAL;
 
-	pvt_info = of_device_get_match_data(pvt->dev);
 	if (!pvt_info) {
 		dev_err(pvt->dev, "No matching device data found\n");
 		return -EINVAL;
@@ -656,8 +657,24 @@ static void eswin_pvt_remove(void *data)
 
 static int eswin_pvt_create_hwmon(struct pvt_hwmon *pvt)
 {
-	pvt->hwmon = devm_hwmon_device_register_with_info(pvt->dev, "dummy_pvt", pvt,
-		&pvt_hwmon_info, NULL);
+	const char *names[2][2] = {
+		{"d0_soc_dummy_pvt", "d0_ddr_dummy_pvt"},
+		{"d1_soc_dummy_pvt", "d1_ddr_dummy_pvt"}
+	};
+	int type;
+
+	if (of_device_is_compatible(pvt->dev->of_node,
+		"eswin,eswin-dummy-pvt-cpu")) {
+		type = 0;
+	} else if (of_device_is_compatible(pvt->dev->of_node,
+		"eswin,eswin-dummy-pvt-ddr")) {
+		type = 1;
+	} else {
+		dev_err(pvt->dev, "Unknown compatible string\n");
+		return -EINVAL;
+	}
+	pvt->hwmon = devm_hwmon_device_register_with_info(pvt->dev,
+		names[pvt->nid][type], pvt, &pvt_hwmon_info, NULL);
 	if (IS_ERR(pvt->hwmon)) {
 		dev_err(pvt->dev, "Couldn't create hwmon device\n");
 		return PTR_ERR(pvt->hwmon);
@@ -669,11 +686,35 @@ static int eswin_pvt_create_hwmon(struct pvt_hwmon *pvt)
 static int eswin_pvt_probe(struct platform_device *pdev)
 {
 	struct pvt_hwmon *pvt;
-	int ret;
+	int ret, nid;
+	const struct pvt_sensor_info *sensor_info;
+
+	/*Get NUMA node ID*/
+	if (of_property_read_s32(pdev->dev.of_node,
+		"numa-node-id", &nid)) {
+		dev_err(&pdev->dev, "numa-node-id was not defined!\n");
+		return -EINVAL;
+	}
+
+	if (of_device_is_compatible(pdev->dev.of_node,
+		"eswin,eswin-dummy-pvt-cpu")) {
+		sensor_info = (nid == 0) ? pvt_info_cpu_d0 :
+					 pvt_info_cpu_d1;
+	} else if (of_device_is_compatible(pdev->dev.of_node,
+		"eswin,eswin-dummy-pvt-ddr")) {
+		sensor_info = (nid == 0) ? pvt_info_ddr_d0 :
+					 pvt_info_ddr_d1;
+	} else {
+		dev_err(&pdev->dev, "Unknown compatible string\n");
+		return -EINVAL;
+	}
 
+	platform_set_drvdata(pdev, (void *)sensor_info);
 	pvt = eswin_pvt_create_data(pdev);
 	if (IS_ERR(pvt))
 		return PTR_ERR(pvt);
+	pvt->sensor_info = sensor_info;
+	pvt->nid = nid;
 
 	pvt->regmap = syscon_regmap_lookup_by_phandle(pdev->dev.of_node, "eswin,syscon");
 	if (IS_ERR(pvt->regmap)) {
@@ -705,10 +746,8 @@ static int eswin_pvt_probe(struct platform_device *pdev)
 }
 
 static const struct of_device_id pvt_of_match[] = {
-	{ .compatible = "eswin,eswin-dummy-pvt-cpu",
-	 .data = &pvt_info_cpu},
-	{ .compatible = "eswin,eswin-dummy-pvt-ddr",
-	 .data = &pvt_info_ddr},
+	{ .compatible = "eswin,eswin-dummy-pvt-cpu"},
+	{ .compatible = "eswin,eswin-dummy-pvt-ddr"},
 	{ }
 };
 MODULE_DEVICE_TABLE(of, pvt_of_match);
diff --git a/drivers/hwmon/eswin_pvt.c b/drivers/hwmon/eswin_pvt.c
index d706a12808a54..19ad0c2a548c0 100644
--- a/drivers/hwmon/eswin_pvt.c
+++ b/drivers/hwmon/eswin_pvt.c
@@ -50,6 +50,24 @@
  * with the sensor names, activation modes, threshold registers base address
  * and the thresholds bit fields.
  */
+#ifdef CONFIG_ARCH_ESWIN_EIC7702_SOC
+static const struct pvt_sensor_info pvt_info_ddr_d0[] = {
+	PVT_SENSOR_INFO(0, "D0 DDR Core Temperature", hwmon_temp, TEMP, TTHRES),
+	PVT_SENSOR_INFO(0, "D0 DDR Core Voltage", hwmon_in, VOLT, VTHRES),
+	PVT_SENSOR_INFO(1, "D0 DDR Core Low-Vt", hwmon_in, LVT, LTHRES),
+	PVT_SENSOR_INFO(2, "D0 DDR Core UltraLow-Vt", hwmon_in, ULVT, ULTHRES),
+	PVT_SENSOR_INFO(3, "D0 DDR Core Standard-Vt", hwmon_in, SVT, STHRES),
+};
+
+static const struct pvt_sensor_info pvt_info_ddr_d1[] = {
+	PVT_SENSOR_INFO(0, "D1 DDR Core Temperature", hwmon_temp, TEMP, TTHRES),
+	PVT_SENSOR_INFO(0, "D1 DDR Core Voltage", hwmon_in, VOLT, VTHRES),
+	PVT_SENSOR_INFO(1, "D1 DDR Core Low-Vt", hwmon_in, LVT, LTHRES),
+	PVT_SENSOR_INFO(2, "D1 DDR Core UltraLow-Vt", hwmon_in, ULVT, ULTHRES),
+	PVT_SENSOR_INFO(3, "D1 DDR Core Standard-Vt", hwmon_in, SVT, STHRES),
+};
+
+#else
 static const struct pvt_sensor_info pvt_info_cpu[] = {
 	PVT_SENSOR_INFO(0, "SoC Temperature", hwmon_temp, TEMP, TTHRES),
 	PVT_SENSOR_INFO(0, "SoC Voltage", hwmon_in, VOLT, VTHRES),
@@ -65,6 +83,7 @@ static const struct pvt_sensor_info pvt_info_ddr[] = {
 	PVT_SENSOR_INFO(2, "DDR Core UltraLow-Vt", hwmon_in, ULVT, ULTHRES),
 	PVT_SENSOR_INFO(3, "DDR Core Standard-Vt", hwmon_in, SVT, STHRES),
 };
+#endif
 
 /*
  * The original translation formulae of the temperature (in degrees of Celsius)
@@ -239,9 +258,8 @@ static int eswin_pvt_read_data(struct pvt_hwmon *pvt, enum pvt_sensor_type type,
 	unsigned long timeout;
 	u32 data;
 	int ret;
-	const struct pvt_sensor_info *pvt_info;
+	const struct pvt_sensor_info *pvt_info = pvt->sensor_info;
 
-	pvt_info = of_device_get_match_data(pvt->dev);
 	if (!pvt_info) {
 		dev_err(pvt->dev, "No matching device data found\n");
 		return -EINVAL;
@@ -552,12 +570,11 @@ static int eswin_pvt_hwmon_read_string(struct device *dev,
 {
 	struct pvt_hwmon *pvt = dev_get_drvdata(dev);
 
-	const struct pvt_sensor_info *pvt_info;
+	const struct pvt_sensor_info *pvt_info = pvt->sensor_info;
 
 	if (!eswin_pvt_hwmon_channel_is_valid(type, ch))
 		return -EINVAL;
 
-	pvt_info = of_device_get_match_data(pvt->dev);
 	if (!pvt_info) {
 		dev_err(pvt->dev, "No matching device data found\n");
 		return -EINVAL;
@@ -770,14 +787,13 @@ static int eswin_pvt_check_pwr(struct pvt_hwmon *pvt)
 static int eswin_pvt_init_iface(struct pvt_hwmon *pvt)
 {
 	unsigned long rate;
-	const struct pvt_sensor_info *pvt_info;
+	const struct pvt_sensor_info *pvt_info = pvt->sensor_info;
 
 	rate = clk_get_rate(pvt->clk);
 	if (!rate) {
 		dev_err(pvt->dev, "Invalid reference clock rate\n");
 		return -ENODEV;
 	}
-	pvt_info = of_device_get_match_data(pvt->dev);
 	if (!pvt_info) {
 		dev_err(pvt->dev, "No matching device data found\n");
 		return -EINVAL;
@@ -846,8 +862,29 @@ static int eswin_pvt_request_irq(struct pvt_hwmon *pvt)
 
 static int eswin_pvt_create_hwmon(struct pvt_hwmon *pvt)
 {
-	pvt->hwmon = devm_hwmon_device_register_with_info(pvt->dev, "pvt", pvt,
-		&pvt_hwmon_info, NULL);
+	int type;
+
+	if (of_device_is_compatible(pvt->dev->of_node,
+		"eswin,eswin-pvt-cpu")) {
+		type = 0;
+	} else if (of_device_is_compatible(pvt->dev->of_node,
+		"eswin,eswin-pvt-ddr")) {
+		type = 1;
+	}
+
+	#ifdef CONFIG_ARCH_ESWIN_EIC7702_SOC
+		const char *names[2][2] = {
+			{"", "d0_ddr_pvt"},
+			{"", "d1_ddr_pvt"}
+		};
+	#else
+		const char *names[1][2] = {
+			{"soc_pvt", "ddr_pvt"},
+		};
+	#endif
+
+	pvt->hwmon = devm_hwmon_device_register_with_info(pvt->dev,
+	names[pvt->nid][type], pvt, &pvt_hwmon_info, NULL);
 	if (IS_ERR(pvt->hwmon)) {
 		dev_err(pvt->dev, "Couldn't create hwmon device\n");
 		return PTR_ERR(pvt->hwmon);
@@ -864,11 +901,39 @@ static int eswin_pvt_enable_iface(struct pvt_hwmon *pvt)
 static int eswin_pvt_probe(struct platform_device *pdev)
 {
 	struct pvt_hwmon *pvt;
-	int ret;
+	int ret, nid;
+	const struct pvt_sensor_info *sensor_info;
+
+	/* Get NUMA node ID */
+	if (of_property_read_s32(pdev->dev.of_node,
+		"numa-node-id", &nid)) {
+		dev_err(&pdev->dev, "numa-node-id was not defined!\n");
+		return -EINVAL;
+	}
+
+	#ifdef CONFIG_ARCH_ESWIN_EIC7702_SOC
+		if (of_device_is_compatible(pdev->dev.of_node,
+			"eswin,eswin-pvt-ddr")) {
+			sensor_info = (nid == 0) ? pvt_info_ddr_d0 :
+						pvt_info_ddr_d1;
+		}
+	#else
+		if (of_device_is_compatible(pdev->dev.of_node,
+		"eswin,eswin-pvt-cpu")) {
+			sensor_info = pvt_info_cpu;
+		} else if (of_device_is_compatible(pdev->dev.of_node,
+			"eswin,eswin-pvt-ddr")) {
+			sensor_info = pvt_info_ddr;
+		}
+	#endif
+
+	platform_set_drvdata(pdev, (void *)sensor_info);
 
 	pvt = eswin_pvt_create_data(pdev);
 	if (IS_ERR(pvt))
 		return PTR_ERR(pvt);
+	pvt->sensor_info = sensor_info;
+	pvt->nid = nid;
 
 	ret = eswin_pvt_request_regs(pvt);
 	if (ret)
@@ -971,10 +1036,8 @@ static const struct dev_pm_ops eswin_pvt_pm = {
 };
 
 static const struct of_device_id pvt_of_match[] = {
-	{ .compatible = "eswin,eswin-pvt-cpu",
-	 .data = &pvt_info_cpu},
-	{ .compatible = "eswin,eswin-pvt-ddr",
-	 .data = &pvt_info_ddr},
+	{ .compatible = "eswin,eswin-pvt-cpu"},
+	{ .compatible = "eswin,eswin-pvt-ddr"},
 	{ }
 };
 MODULE_DEVICE_TABLE(of, pvt_of_match);
diff --git a/drivers/hwmon/eswin_pvt.h b/drivers/hwmon/eswin_pvt.h
