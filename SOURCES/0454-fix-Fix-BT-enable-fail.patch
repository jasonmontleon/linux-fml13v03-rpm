From eb27aa7af7e1e5aaf649cf7939bc2494265296e3 Mon Sep 17 00:00:00 2001
From: wangjinlong <wangjinlong@eswincomputing.com>
Date: Thu, 31 Jul 2025 10:30:40 +0800
Subject: [PATCH 454/540] fix: Fix BT enable fail

Changelogs:
1. fix hci0 down after set wlan down

Signed-off-by: wangjinlong <wangjinlong@eswincomputing.com>
---
 drivers/net/wireless/ap12275/Makefile       |  4 ++--
 drivers/net/wireless/ap12275/dhd_ip.c       |  2 +-
 drivers/net/wireless/ap12275/dhd_linux.c    | 13 ++++++++++---
 drivers/net/wireless/ap12275/dhd_linux_rx.c |  4 ++--
 4 files changed, 15 insertions(+), 8 deletions(-)

diff --git a/drivers/net/wireless/ap12275/Makefile b/drivers/net/wireless/ap12275/Makefile
index c75fa9514804..cb41a87bc81e 100644
--- a/drivers/net/wireless/ap12275/Makefile
+++ b/drivers/net/wireless/ap12275/Makefile
@@ -63,8 +63,8 @@ DHDCFLAGS = -Wall -Wstrict-prototypes -Wno-date-time                      \
 	-DPOWERUP_MAX_RETRY=0 -DIFACE_HANG_FORCE_DEV_CLOSE -DWAIT_DEQUEUE     \
 	-DUSE_NEW_RSPEC_DEFS                                                  \
 	-DWL_EXT_IAPSTA -DWL_ESCAN -DCCODE_LIST -DSUSPEND_EVENT               \
-	-DKEY_INSTALL_CHECK                                                   \
-	-DENABLE_INSMOD_NO_FW_LOAD -DENODEBUG
+	-DKEY_INSTALL_CHECK -DENODEBUG
+#	-DENABLE_INSMOD_NO_FW_LOAD
 
 DHDOFILES = aiutils.o siutils.o sbutils.o                                 \
 	bcmutils.o bcmwifi_channels.o bcmxtlv.o bcm_app_utils.o bcmstdlib_s.o \
diff --git a/drivers/net/wireless/ap12275/dhd_ip.c b/drivers/net/wireless/ap12275/dhd_ip.c
index 32788cccf560..972012e9f757 100644
--- a/drivers/net/wireless/ap12275/dhd_ip.c
+++ b/drivers/net/wireless/ap12275/dhd_ip.c
@@ -375,7 +375,7 @@ int dhd_tcpack_suppress_set(dhd_pub_t *dhdp, uint8 mode)
 	prev_mode = dhdp->tcpack_sup_mode;
 
 	if (prev_mode == mode) {
-		DHD_ERROR(("%s %d: already set to %d\n", __FUNCTION__, __LINE__, mode));
+		DHD_INFO(("%s %d: already set to %d\n", __FUNCTION__, __LINE__, mode));
 		goto exit;
 	}
 
diff --git a/drivers/net/wireless/ap12275/dhd_linux.c b/drivers/net/wireless/ap12275/dhd_linux.c
index 37c3bd9c6b2b..777308ca4e17 100644
--- a/drivers/net/wireless/ap12275/dhd_linux.c
+++ b/drivers/net/wireless/ap12275/dhd_linux.c
@@ -617,7 +617,9 @@ module_param(dhd_console_ms, uint, 0644);
 uint dhd_console_ms = 0;
 #endif /* DHD_DEBUG */
 
-uint dhd_slpauto = TRUE;
+// Eswin change to FALSE
+//uint dhd_slpauto = TRUE;
+uint dhd_slpauto = FALSE;
 module_param(dhd_slpauto, uint, 0);
 
 #ifdef PKT_FILTER_SUPPORT
@@ -5089,12 +5091,17 @@ void dhd_set_scb_probe(dhd_pub_t *dhd)
 
 	memcpy(&scb_probe, iovbuf, sizeof(wl_scb_probe_t));
 
+	if (NUM_SCB_MAX_PROBE == scb_probe.scb_max_probe){
+		DHD_INFO(("%s: max_scb_probe is the same as the preset value\n", __FUNCTION__));
+		return;
+	}
+
 	scb_probe.scb_max_probe = NUM_SCB_MAX_PROBE;
 
 	ret = dhd_iovar(dhd, 0, "scb_probe", (char *)&scb_probe, sizeof(wl_scb_probe_t), NULL, 0,
 			TRUE);
 	if (ret < 0) {
-		DHD_ERROR(("%s: max_scb_probe setting failed\n", __FUNCTION__));
+		DHD_ERROR(("%s: max_scb_probe setting failed ret=%d\n", __FUNCTION__, ret));
 		return;
 	}
 }
@@ -10260,7 +10267,7 @@ dhd_bus_start(dhd_pub_t *dhdp)
 
 #if defined(DHD_DEBUG) && defined(BCMSDIO)
 	f2_sync_end = OSL_SYSUPTIME();
-	DHD_ERROR(("Time taken for FW download and F2 ready is: %d msec\n",
+	DHD_INFO(("Time taken for FW download and F2 ready is: %d msec\n",
 			(fw_download_end - fw_download_start) + (f2_sync_end - f2_sync_start)));
 #endif /* DHD_DEBUG && BCMSDIO */
 
diff --git a/drivers/net/wireless/ap12275/dhd_linux_rx.c b/drivers/net/wireless/ap12275/dhd_linux_rx.c
index ae2044be6a42..3131e050c568 100644
--- a/drivers/net/wireless/ap12275/dhd_linux_rx.c
+++ b/drivers/net/wireless/ap12275/dhd_linux_rx.c
@@ -458,7 +458,7 @@ dhd_rx_frame(dhd_pub_t *dhdp, int ifidx, void *pktbuf, int numpkt, uint8 chan)
 			(ntoh16(eh->ether_type) != ETHER_TYPE_BRCM))
 #endif /* PROP_TXSTATUS_VSDB */
 		{
-			DHD_ERROR(("%s: net device is NOT registered yet. drop packet\n",
+			DHD_INFO(("%s: net device is NOT registered yet. drop packet\n",
 			__FUNCTION__));
 			PKTCFREE(dhdp->osh, pktbuf, FALSE);
 			continue;
@@ -897,7 +897,7 @@ dhd_rx_frame(dhd_pub_t *dhdp, int ifidx, void *pktbuf, int numpkt, uint8 chan)
 				dhd->pub.up))
 #endif /* PROP_TXSTATUS_VSDB */
 			{
-				DHD_ERROR(("%s: net device is NOT registered. drop event packet\n",
+				DHD_INFO(("%s: net device is NOT registered. drop event packet\n",
 				__FUNCTION__));
 				PKTFREE_CTRLBUF(dhdp->osh, pktbuf, FALSE);
 				continue;
-- 
2.54.0

