From 3eac77cbf6c7ff6959b7db7bbfccfe0c2cf55fae Mon Sep 17 00:00:00 2001
From: "yang.wang" <yang.wang@deepcomputing.io>
Date: Wed, 26 Mar 2025 17:36:14 +0800
Subject: [PATCH 268/540] EC: add support for special function keys: KEY_MEDIA
 and KEY_RFKILL.

Signed-off-by: yang.wang <yang.wang@deepcomputing.io>
---
 .../boot/dts/eswin/eic7702-deepcomputing-fml13v03.dts  |  7 +++++++
 arch/riscv/configs/fml13v03_defconfig                  |  3 +--
 drivers/input/keyboard/cros_ec_keyb.c                  | 10 ++++++++++
 include/linux/platform_data/cros_ec_commands.h         |  2 ++
 4 files changed, 20 insertions(+), 2 deletions(-)

diff --git a/arch/riscv/boot/dts/eswin/eic7702-deepcomputing-fml13v03.dts b/arch/riscv/boot/dts/eswin/eic7702-deepcomputing-fml13v03.dts
index 4417b24df4320..c6ce1a0113d23 100644
--- a/arch/riscv/boot/dts/eswin/eic7702-deepcomputing-fml13v03.dts
+++ b/arch/riscv/boot/dts/eswin/eic7702-deepcomputing-fml13v03.dts
@@ -1658,6 +1658,13 @@ conf {
 	};
 };
 
+&fwos_ec {
+	keyboard-controller {
+		compatible = "google,cros-ec-keyb-switches";
+		status = "okay";
+	};
+};
+
 /* die0 GPIO Function Description
 
 	gpio0   : pcie prstn(I)
diff --git a/arch/riscv/configs/fml13v03_defconfig b/arch/riscv/configs/fml13v03_defconfig
index e0bbfa825341e..cd4d8cee38bfd 100755
--- a/arch/riscv/configs/fml13v03_defconfig
+++ b/arch/riscv/configs/fml13v03_defconfig
@@ -442,11 +442,10 @@ CONFIG_RTL8192SE=m
 # CONFIG_WLAN_VENDOR_ZYDAS is not set
 # CONFIG_WLAN_VENDOR_QUANTENNA is not set
 CONFIG_INPUT_EVDEV=y
-# CONFIG_INPUT_KEYBOARD is not set
+CONFIG_KEYBOARD_CROS_EC=m
 # CONFIG_INPUT_MOUSE is not set
 CONFIG_INPUT_TOUCHSCREEN=y
 CONFIG_TOUCHSCREEN_GOODIX=y
-CONFIG_SERIO_LIBPS2=y
 # CONFIG_LEGACY_PTYS is not set
 CONFIG_SERIAL_8250=y
 CONFIG_SERIAL_8250_CONSOLE=y
diff --git a/drivers/input/keyboard/cros_ec_keyb.c b/drivers/input/keyboard/cros_ec_keyb.c
index 76fcf90ea7c76..b2d13d09a56f0 100644
--- a/drivers/input/keyboard/cros_ec_keyb.c
+++ b/drivers/input/keyboard/cros_ec_keyb.c
@@ -115,6 +115,16 @@ static const struct cros_ec_bs_map cros_ec_keyb_bs[] = {
 		.code           = KEY_SCREENLOCK,
 		.bit            = EC_MKBP_SCREEN_LOCK,
 	},
+	{
+		.ev_type	= EV_KEY,
+		.code		= KEY_MEDIA,
+		.bit		= EC_MKBP_MEDIA_BUTTON,
+	},
+	{
+		.ev_type	= EV_KEY,
+		.code		= KEY_RFKILL,
+		.bit		= EC_MKBP_RFKILL_BUTTON,
+	},
 
 	/* Switches */
 	{
diff --git a/include/linux/platform_data/cros_ec_commands.h b/include/linux/platform_data/cros_ec_commands.h
index 3b422b0de4684..00ac1d572b221 100644
--- a/include/linux/platform_data/cros_ec_commands.h
+++ b/include/linux/platform_data/cros_ec_commands.h
@@ -3490,6 +3490,8 @@ struct ec_response_get_next_event_v1 {
 #define EC_MKBP_BRI_UP		4
 #define EC_MKBP_BRI_DOWN	5
 #define EC_MKBP_SCREEN_LOCK	6
+#define EC_MKBP_MEDIA_BUTTON	7
+#define EC_MKBP_RFKILL_BUTTON	8
 
 /* Switches */
 #define EC_MKBP_LID_OPEN	0
-- 
2.53.0

