From 90444f538c7ca0bb7a10b6d189fd848ec48a2db6 Mon Sep 17 00:00:00 2001
From: Sandie Cao <sandie.cao@deepcomputing.io>
Date: Thu, 15 May 2025 14:17:17 +0800
Subject: [PATCH 296/540] dts: riscv: eswin: fml13v03: add gpu_opp_table for
 d1_gpu

Signed-off-by: Sandie Cao <sandie.cao@deepcomputing.io>
---
 arch/riscv/boot/dts/eswin/eswin-win2030-die1-soc.dtsi | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/arch/riscv/boot/dts/eswin/eswin-win2030-die1-soc.dtsi b/arch/riscv/boot/dts/eswin/eswin-win2030-die1-soc.dtsi
index 49f3179454ed..71868819a401 100644
--- a/arch/riscv/boot/dts/eswin/eswin-win2030-die1-soc.dtsi
+++ b/arch/riscv/boot/dts/eswin/eswin-win2030-die1-soc.dtsi
@@ -1042,8 +1042,9 @@ d1_gpu: gpu@71400000 {
 			dma-noncoherent;
 			numa-node-id = <1>;
 
+			operating-points-v2 = <&gpu_opp_table>;
 			#cooling-cells = <2>;
-			dynamic-power-coefficient = <0>; /*TBD*/
+			dynamic-power-coefficient = <4000>; /*TBD*/
 		};
 
 		d1_sata: sata@0x70420000 {
-- 
2.54.0

