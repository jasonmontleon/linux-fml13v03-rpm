+++ b/arch/riscv/boot/dts/eswin/eic7700-pinctrl.dtsi
@@ -95,6 +95,22 @@ mux{
 					function = "spi1_func";
 				};
 			};
+			
+			pinctrl_dual_spi1_default: dual_spi1-default{
+				mux1 {
+					groups = "spi1_clk_group";
+					function = "spi1_clk_func";
+				};
+				mux2 {
+					groups = "spi1_d0_d1_group";
+					function = "spi1_d0_d1_func";
+				};
+				mux3 {
+					groups = "spi1_cs0_group";
+					function = "spi1_cs0_func";
+				};
+			};
+
             pinctrl_spi3_default: spi3-default{
 				mux {
 					groups = "spi3_group";
@@ -326,6 +342,33 @@ mux4 {
 				};
 			};
 
+            pinctrl_dual_spi2_default: dual_spi2-default{
+				mux1 {
+					groups = "spi2_clk_group";
+					function = "spi2_clk_func";
+				};
+				conf1 {
+					groups = "spi2_clk_group";
+					input-enable = <1>;
+					bias-pull-up = <1>;
+					bias-pull-down = <0>;
+				};
+				mux2 {
+					groups = "spi2_d0_d1_group";
+					function = "spi2_d0_d1_func";
+				};
+				conf2 {
+					groups = "spi2_d0_d1_group";
+					input-enable = <1>;
