From 5da388fcae67d11ca4d2b015e8b8197f8b53bdfe Mon Sep 17 00:00:00 2001
From: Sandie Cao <sandie.cao@deepcomputing.io>
Date: Mon, 17 Mar 2025 18:32:27 +0800
Subject: [PATCH 234/534] riscv: eswin: fml13v03: support grub

Signed-off-by: Sandie Cao <sandie.cao@deepcomputing.io>
---
 .../eswin/eic7702-deepcomputing-fml13v03.dts  |  4 +--
 arch/riscv/configs/fml13v03_defconfig         | 26 +++++++++++++++++++
 2 files changed, 28 insertions(+), 2 deletions(-)

diff --git a/arch/riscv/boot/dts/eswin/eic7702-deepcomputing-fml13v03.dts b/arch/riscv/boot/dts/eswin/eic7702-deepcomputing-fml13v03.dts
index 7be25ad21838..a76e9203d17d 100644
--- a/arch/riscv/boot/dts/eswin/eic7702-deepcomputing-fml13v03.dts
+++ b/arch/riscv/boot/dts/eswin/eic7702-deepcomputing-fml13v03.dts
@@ -125,7 +125,7 @@ g2d_12GB_boundary_reserved_4k {
 
 		mmz_nid_0_part_0 {
 			compatible = "eswin-reserve-memory";
-			reg = <0x3 0x0 0x1 0x80000000>;
+			reg = <0x3 0x0 0x1 0x60000000>;
 			no-map;
 		};
 
@@ -146,7 +146,7 @@ d1_g2d_8GB_boundary_reserved_4k {
 
 		mmz_nid_1_part_0 {
 			compatible = "eswin-reserve-memory";
-			reg = <0x22 0x80000000 0x1 0x80000000>;
+			reg = <0x22 0x80000000 0x1 0x60000000>;
 			no-map;
 		};
 	};
diff --git a/arch/riscv/configs/fml13v03_defconfig b/arch/riscv/configs/fml13v03_defconfig
index 323ba31752ba..2e69a9e8adc3 100755
--- a/arch/riscv/configs/fml13v03_defconfig
+++ b/arch/riscv/configs/fml13v03_defconfig
@@ -311,6 +311,18 @@ CONFIG_PCIE_PTM=y
 CONFIG_PCIE_ESWIN=y
 CONFIG_DEVTMPFS=y
 CONFIG_DEVTMPFS_MOUNT=y
+CONFIG_DEVTMPFS_SAFE=y
+CONFIG_FW_LOADER_USER_HELPER=y
+CONFIG_FW_LOADER_COMPRESS=y
+CONFIG_FW_LOADER_COMPRESS_ZSTD=y
+CONFIG_FIRMWARE_MEMMAP=y
+CONFIG_SYSFB_SIMPLEFB=y
+CONFIG_EFI_VARS_PSTORE=m
+CONFIG_EFI_BOOTLOADER_CONTROL=m
+CONFIG_EFI_CAPSULE_LOADER=m
+CONFIG_EFI_TEST=m
+CONFIG_RESET_ATTACK_MITIGATION=y
+CONFIG_EFI_COCO_SECRET=y
 CONFIG_MTD=y
 CONFIG_MTD_SPI_NOR=y
 CONFIG_BLK_DEV_LOOP=y
@@ -644,6 +656,7 @@ CONFIG_DW_HDMI_CEC=y
 CONFIG_DRM_IMG_VOLCANIC=m
 CONFIG_DRM_LEGACY=y
 CONFIG_FB=y
+CONFIG_FB_EFI=y
 CONFIG_FB_RADEON=m
 CONFIG_FB_SIMPLE=m
 CONFIG_BACKLIGHT_PWM=y
@@ -780,6 +793,7 @@ CONFIG_INTERCONNECT=y
 CONFIG_EXT4_FS=y
 CONFIG_EXT4_FS_POSIX_ACL=y
 CONFIG_EXT4_FS_SECURITY=y
+CONFIG_FAT_FS=y
 CONFIG_BTRFS_FS=m
 CONFIG_BTRFS_FS_POSIX_ACL=y
 CONFIG_FS_ENCRYPTION=y
@@ -799,6 +813,12 @@ CONFIG_NTFS_FS=m
 CONFIG_NTFS_RW=y
 CONFIG_TMPFS=y
 CONFIG_TMPFS_POSIX_ACL=y
+CONFIG_TMPFS_POSIX_ACL=y
+CONFIG_TMPFS_INODE64=y
+CONFIG_TMPFS_QUOTA=y
+CONFIG_HUGETLBFS=y
+CONFIG_HUGETLB_PAGE_OPTIMIZE_VMEMMAP_DEFAULT_ON=y
+CONFIG_EFIVAR_FS=y
 CONFIG_SQUASHFS=m
 CONFIG_SQUASHFS_FILE_DIRECT=y
 CONFIG_SQUASHFS_COMPILE_DECOMP_MULTI_PERCPU=y
@@ -863,3 +883,9 @@ CONFIG_RCU_EQS_DEBUG=y
 # CONFIG_FTRACE is not set
 # CONFIG_RUNTIME_TESTING_MENU is not set
 CONFIG_MEMTEST=y
+CONFIG_EFI_VARS_PSTORE=m
+CONFIG_EFI_BOOTLOADER_CONTROL=m
+CONFIG_EFI_CAPSULE_LOADER=m
+CONFIG_EFI_TEST=m
+CONFIG_EFI_COCO_SECRET=y
+CONFIG_EFI_STUB=y
-- 
