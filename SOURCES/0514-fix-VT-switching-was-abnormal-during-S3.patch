From be324e2e74c44393b24a795818f7b4b53f73594d Mon Sep 17 00:00:00 2001
From: gengzonglin <gengzonglin@eswincomputing.com>
Date: Thu, 18 Sep 2025 10:22:10 +0800
Subject: [PATCH 514/533] fix:VT switching was abnormal during S3.

Changelogs:
	 1.Disable VT switching during S3.

Signed-off-by: gengzonglin gengzonglin@eswincomputing.com
---
 drivers/gpu/drm/eswin/es_drv.c | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/drivers/gpu/drm/eswin/es_drv.c b/drivers/gpu/drm/eswin/es_drv.c
index 1ee7f00528c1..1809b0a5f2a0 100644
--- a/drivers/gpu/drm/eswin/es_drv.c
+++ b/drivers/gpu/drm/eswin/es_drv.c
@@ -334,6 +334,9 @@ static int es_drm_bind(struct device *dev)
 
 	drm_fbdev_generic_setup(drm_dev, 32);
 
+	/* Disable VT switch for suspend/resume */
+	pm_set_vt_switch(0);
+
 	ret = of_property_read_u32(dev->of_node, "numa-node-id", &id);
 	if (ret) {
 		DRM_DEV_ERROR(dev, "Failed to read index property, ret = %d\n",
-- 
