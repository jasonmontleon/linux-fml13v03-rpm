+++ b/arch/riscv/boot/dts/eswin/eic7702-d560-interleave.dts
@@ -306,6 +306,17 @@ &d1_timer1 {
 	status = "disabled";
 };
 
+&pcie {
+	status = "okay";
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_die1_gpio21_default>;
+	pci-socket-gpios = <&d1_porta 21 GPIO_ACTIVE_HIGH>;
+};
+
+&d1_pcie {
+	status = "okay";
+};
+
 &pinctrl {
 	status = "okay";
 	pinctrl-names = "default";
