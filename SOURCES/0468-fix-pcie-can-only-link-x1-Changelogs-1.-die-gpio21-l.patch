 arch/riscv/boot/dts/eswin/eic7702-d560.dts            | 11 +++++++++++
 2 files changed, 22 insertions(+)

diff --git a/arch/riscv/boot/dts/eswin/eic7702-d560-interleave.dts b/arch/riscv/boot/dts/eswin/eic7702-d560-interleave.dts
index 663f157a57ae3..18897dc8d6c36 100644
