 	}
 
-	ret = lpcpu_boot_status(lpcpu->mbox_channel);
+	ret = lpcpu_boot_status(lpcpu->mbox_channel, vdd_config_msg);
 	if (ret < 0) {
 		dev_err(dev, "Send message to lpcpu via mailbox failed!\n");
 		goto err_mmio;
