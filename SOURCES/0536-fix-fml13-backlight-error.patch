From 0c079858d68664ee863a93a346018254786f96b7 Mon Sep 17 00:00:00 2001
From: Xiang Xu <xuxiang@eswincomputing.com>
Date: Wed, 29 Oct 2025 20:41:39 +0800
Subject: [PATCH 536/540] fix:fml13 backlight error

Changelogs:
1. fix fml13 backlight configuration error

Signed-off-by: Xiang Xu <xuxiang@eswincomputing.com>
---
 scripts/Makefile.lib | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/scripts/Makefile.lib b/scripts/Makefile.lib
index 1da8d567e333..c3c5ac113c6a 100644
--- a/scripts/Makefile.lib
+++ b/scripts/Makefile.lib
@@ -388,9 +388,11 @@ $(obj)/%.dtb.S: $(obj)/%.dtb FORCE
 $(obj)/%.dtbo.S: $(obj)/%.dtbo FORCE
 	$(call if_changed,wrap_S_dtb)
 
+DTC_SYMBOLS_FLAG_DEFAULT := $(if $(findstring .dtso,$<),-@,)
+
 quiet_cmd_dtc = DTC     $@
 cmd_dtc = $(HOSTCC) -E $(dtc_cpp_flags) -x assembler-with-cpp -o $(dtc-tmp) $< ; \
-	$(DTC) -@ -o $@ -b 0 \
+	$(DTC) $(or $(DTC_SYMBOLS_FLAG_$(notdir $@)),$(DTC_SYMBOLS_FLAG_DEFAULT)) -o $@ -b 0 \
 		$(addprefix -i,$(dir $<) $(DTC_INCLUDE)) $(DTC_FLAGS) \
 		-d $(depfile).dtc.tmp $(dtc-tmp) ; \
 	cat $(depfile).pre.tmp $(depfile).dtc.tmp > $(depfile)
-- 
2.54.0

