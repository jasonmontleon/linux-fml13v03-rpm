From bac3a2f553ab640b314ce6a0877f55b98c1f00c1 Mon Sep 17 00:00:00 2001
From: cheney <11722200@qq.com>
Date: Wed, 19 Mar 2025 18:07:48 +0800
Subject: [PATCH 261/540] Add Wifi/BT Support.

---
 .../boot/dts/eswin/eic7702-deepcomputing-fml13v03.dts  |  5 +++++
 arch/riscv/boot/dts/eswin/eic7x-die0-pinctrl.dtsi      |  5 +++++
 arch/riscv/boot/dts/eswin/eic7x-die1-pinctrl.dtsi      |  6 +++---
 arch/riscv/configs/fml13v03_defconfig                  | 10 ++++++++++
 4 files changed, 23 insertions(+), 3 deletions(-)

diff --git a/arch/riscv/boot/dts/eswin/eic7702-deepcomputing-fml13v03.dts b/arch/riscv/boot/dts/eswin/eic7702-deepcomputing-fml13v03.dts
index 2161add2de9be..b5e4706815362 100644
--- a/arch/riscv/boot/dts/eswin/eic7702-deepcomputing-fml13v03.dts
+++ b/arch/riscv/boot/dts/eswin/eic7702-deepcomputing-fml13v03.dts
@@ -494,7 +494,12 @@ &d1_lpcpu {
 &pcie {
 	/* m.2 ssd key m */
 	status = "okay";
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_die0_gpio27_default
+				 &pinctrl_die1_gpio16_default
+				 &pinctrl_die1_gpio18_default>;
 };
+
 &d1_pcie {
 	/* wifi key e */
 	status = "okay";
diff --git a/arch/riscv/boot/dts/eswin/eic7x-die0-pinctrl.dtsi b/arch/riscv/boot/dts/eswin/eic7x-die0-pinctrl.dtsi
index 8409a0886b7da..9e8e0ce060a1e 100644
--- a/arch/riscv/boot/dts/eswin/eic7x-die0-pinctrl.dtsi
+++ b/arch/riscv/boot/dts/eswin/eic7x-die0-pinctrl.dtsi
@@ -799,6 +799,11 @@ mux {
 					groups = "gpio27_group";
 					function = "gpio27_func";
 				};
+				conf {
+					groups = "gpio27_group";
+					input-enable = <0>;
+					bias-pull-up = <1>;
+				};
 			};
             pinctrl_die0_gpio28_default: gpio28-default{
 				mux {
diff --git a/arch/riscv/boot/dts/eswin/eic7x-die1-pinctrl.dtsi b/arch/riscv/boot/dts/eswin/eic7x-die1-pinctrl.dtsi
index fcb3d855c105d..8a1c568c104e2 100644
--- a/arch/riscv/boot/dts/eswin/eic7x-die1-pinctrl.dtsi
+++ b/arch/riscv/boot/dts/eswin/eic7x-die1-pinctrl.dtsi
@@ -717,7 +717,7 @@ mux {
 				conf {
 					groups = "gpio16_group";
 					input-enable = <0>;
-					bias-pull-down = <1>;
+					bias-pull-up = <1>;
 				};
 			};
             pinctrl_die1_gpio18_default: gpio18-default{
@@ -727,8 +727,8 @@ mux {
 				};
 				conf {
 					groups = "gpio18_group";
-					input-enable = <1>;
-					bias-pull-down = <1>;
+					input-enable = <0>;
+					bias-pull-up = <1>;
 				};
 			};
             pinctrl_die1_gpio19_default: gpio19-default{
diff --git a/arch/riscv/configs/fml13v03_defconfig b/arch/riscv/configs/fml13v03_defconfig
index 9d0e62125f2bc..0fbd77c040e21 100755
--- a/arch/riscv/configs/fml13v03_defconfig
+++ b/arch/riscv/configs/fml13v03_defconfig
@@ -296,6 +296,16 @@ CONFIG_BT_BNEP=m
 CONFIG_BT_BNEP_MC_FILTER=y
 CONFIG_BT_BNEP_PROTO_FILTER=y
 CONFIG_BT_HIDP=m
+CONFIG_BT_INTEL=m
+CONFIG_BT_BCM=m
+CONFIG_BT_RTL=m
+CONFIG_BT_MTK=m
+CONFIG_BT_HCIBTUSB=m
+CONFIG_BT_HCIBTUSB_AUTOSUSPEND=y
+CONFIG_BT_HCIBTUSB_POLL_SYNC=y
+CONFIG_BT_HCIBTUSB_BCM=y
+CONFIG_BT_HCIBTUSB_MTK=y
+CONFIG_BT_HCIBTUSB_RTL=y
 CONFIG_MCTP=y
 CONFIG_CFG80211=y
 CONFIG_CFG80211_WEXT=y
-- 
2.53.0

