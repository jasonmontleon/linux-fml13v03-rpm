From 318da85bf3e8572613277665d1698eb5c840296a Mon Sep 17 00:00:00 2001
From: linmin <linmin@eswincomputing.com>
Date: Mon, 3 Mar 2025 16:06:13 +0800
Subject: [PATCH 323/540] fix(dambuf helper):fix bug of heap object release

Changelogs:
1.mutext was not locked before releasing the heap object.

Signed-off-by: linmin <linmin@eswincomputing.com>
---
 .../dmabuf-heap-import-helper.c               | 22 +++++--------------
 1 file changed, 6 insertions(+), 16 deletions(-)

diff --git a/drivers/memory/eswin/es_rsvmem_heap/dmabuf-heap-import-helper.c b/drivers/memory/eswin/es_rsvmem_heap/dmabuf-heap-import-helper.c
index fa0297c4e606b..f0d67b27ae4ba 100644
--- a/drivers/memory/eswin/es_rsvmem_heap/dmabuf-heap-import-helper.c
+++ b/drivers/memory/eswin/es_rsvmem_heap/dmabuf-heap-import-helper.c
@@ -412,14 +412,9 @@ void common_dmabuf_heap_release(struct heap_mem *heap_obj)
 {
 	struct heap_root *root = heap_obj->root;
 
-	if(!mutex_is_locked(&root->lock)) {
-		mutex_lock(&root->lock);
-		kref_put(&heap_obj->refcount, __common_dmabuf_heap_release);
-		mutex_unlock(&root->lock);
-	}
-	else {
-		kref_put(&heap_obj->refcount, __common_dmabuf_heap_release);
-	}
+	mutex_lock(&root->lock);
+	kref_put(&heap_obj->refcount, __common_dmabuf_heap_release);
+	mutex_unlock(&root->lock);
 }
 EXPORT_SYMBOL(common_dmabuf_heap_release);
 
@@ -588,14 +583,9 @@ void common_dmabuf_heap_rsv_iova_unmap(struct heap_mem *heap_obj)
 {
 	struct heap_root *root = heap_obj->root;
 
-	if(!mutex_is_locked(&root->lock)) {
-		mutex_lock(&root->lock);
-		kref_put(&heap_obj->refcount, __common_dmabuf_heap_rsv_iova_unmap);
-		mutex_unlock(&root->lock);
-	}
-	else {
-		kref_put(&heap_obj->refcount, __common_dmabuf_heap_rsv_iova_unmap);
-	}
+	mutex_lock(&root->lock);
+	kref_put(&heap_obj->refcount, __common_dmabuf_heap_rsv_iova_unmap);
+	mutex_unlock(&root->lock);
 }
 EXPORT_SYMBOL(common_dmabuf_heap_rsv_iova_unmap);
 
