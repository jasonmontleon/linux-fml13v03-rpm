From 3ea17845d88a9064b36e010ce006613db682d930 Mon Sep 17 00:00:00 2001
From: hehuan1 <hehuan1@eswincomputing.com>
Date: Wed, 20 Aug 2025 16:07:48 +0800
Subject: [PATCH 497/533] fix: resolve abnormal prints

    Changelogs:
    resolve abnormal prints

Signed-off-by: hehuan1 <hehuan1@eswincomputing.com>
---
 drivers/hwmon/eswin_pvt.c | 45 +++++++++++++++++++++++++++++++++++++--
 1 file changed, 43 insertions(+), 2 deletions(-)

diff --git a/drivers/hwmon/eswin_pvt.c b/drivers/hwmon/eswin_pvt.c
index c1f39c940df5..7d78c4f37d63 100644
--- a/drivers/hwmon/eswin_pvt.c
+++ b/drivers/hwmon/eswin_pvt.c
@@ -84,7 +84,7 @@ static const struct pvt_sensor_info pvt_info_ddr[] = {
 	PVT_SENSOR_INFO(3, "DDR Core Standard-Vt", hwmon_in, SVT, STHRES),
 };
 #endif
-
+static LIST_HEAD(eswin_pvt_dev);
 /*
  * The original translation formulae of the temperature (in degrees of Celsius)
  * to PVT data and vice-versa are following:
@@ -302,6 +302,43 @@ static int eswin_pvt_read_data(struct pvt_hwmon *pvt, enum pvt_sensor_type type,
 	return 0;
 }
 
+int eswin_get_ddr_temp(const char *name, int numa_id, long *val)
+{
+	struct pvt_hwmon *pvt = NULL;
+	int ret = -EINVAL;
+
+	list_for_each_entry(pvt, &eswin_pvt_dev, entry) {
+		if (pvt->sensor_info && strstr(pvt->sensor_info->label, name) && (pvt->nid == numa_id)) {
+			ret = eswin_pvt_read_data(pvt, PVT_TEMP, val);
+		}
+	}
+	return ret;
+}
+EXPORT_SYMBOL_GPL(eswin_get_ddr_temp);
+
+static int eswin_get_cpu_onedie_temp(const char *name, int numa_id, long *val)
+{
+	struct pvt_hwmon *pvt = NULL;
+	int ret = -EINVAL;
+
+	list_for_each_entry(pvt, &eswin_pvt_dev, entry) {
+		if (pvt->sensor_info && strstr(pvt->sensor_info->label, name) && (pvt->nid == numa_id)) {
+			ret = eswin_pvt_read_data(pvt, PVT_TEMP, val);
+		}
+	}
+	return ret;
+}
+
+int eswin_get_cpu_temp(const char *name, int numa_id, long *val)
+{
+#ifdef CONFIG_ARCH_ESWIN_EIC7702_SOC
+	return eswin_get_cpu_7702_temp(name, numa_id, val);
+#else
+	return eswin_get_cpu_onedie_temp(name, numa_id, val);
+#endif
+}
+EXPORT_SYMBOL_GPL(eswin_get_cpu_temp);
+
 static int eswin_pvt_read_limit(struct pvt_hwmon *pvt, enum pvt_sensor_type type,
 			  bool is_low, long *val)
 {
@@ -673,6 +710,7 @@ static struct pvt_hwmon *eswin_pvt_create_data(struct platform_device *pdev)
 	pvt->dev = dev;
 	pvt->sensor = PVT_SENSOR_FIRST;
 	mutex_init(&pvt->iface_mtx);
+	INIT_LIST_HEAD(&pvt->entry);
 
 	for (idx = 0; idx < PVT_SENSORS_NUM; ++idx)
 		init_completion(&pvt->cache[idx].conversion);
@@ -709,6 +747,8 @@ static void eswin_pvt_remove(void *data)
 	pm_runtime_disable(pvt->dev);
 
 	clk_disable_unprepare(pvt->clk);
+
+	list_del(&pvt->entry);
 }
 
 static int eswin_pvt_request_clks(struct pvt_hwmon *pvt)
@@ -970,6 +1010,7 @@ static int eswin_pvt_probe(struct platform_device *pdev)
 	pm_runtime_set_active(&pdev->dev);
 	pm_runtime_enable(&pdev->dev);
 
+	list_add(&pvt->entry, &eswin_pvt_dev);
 	return 0;
 }
 
@@ -1036,7 +1077,7 @@ static struct platform_driver pvt_driver = {
 	.driver = {
 		.name = "eswin-pvt",
 		.of_match_table = pvt_of_match,
-		.pm = pm_ptr(&eswin_pvt_pm)
+		.pm = pm_sleep_ptr(&eswin_pvt_pm)
 	},
 };
 module_platform_driver(pvt_driver);
-- 
2.52.0

