From 5e055ece817c5fe2475d48a37232b4bccaba4d83 Mon Sep 17 00:00:00 2001
From: sandiecao <sandie.cao@deepcomputing.io>
Date: Mon, 29 Sep 2025 14:25:24 +0800
Subject: [PATCH 439/534] WIN2030-18008:feat:npu frame schedule fix when npu
 suspend.

Changelogs:
1. npu frame schedule fix.

Change-Id: Ie66d6040904dc2cae3036eaf011160a068c97b29
Signed-off-by: zhuxuefei <zhuxuefei@eswincomputing.com>
---
 drivers/soc/eswin/ai_driver/npu/npu_main.c  | 9 +++++++--
 drivers/soc/eswin/ai_driver/npu/scheduler.c | 9 ++++++---
 2 files changed, 13 insertions(+), 5 deletions(-)

diff --git a/drivers/soc/eswin/ai_driver/npu/npu_main.c b/drivers/soc/eswin/ai_driver/npu/npu_main.c
index cea167f9c138..84fb77bff04d 100644
--- a/drivers/soc/eswin/ai_driver/npu/npu_main.c
+++ b/drivers/soc/eswin/ai_driver/npu/npu_main.c
@@ -934,6 +934,7 @@ int __maybe_unused npu_suspend(struct device *dev)
 	struct win_engine *engine = (struct win_engine *)nvdla_dev->win_engine;
 	int is_enable = 0;
 	int ret = 0;
+	nvdla_dev->is_suspend = true;
 
 	dev_dbg(dev, "%s\n", __func__);
 	ret = npu_hardware_reset(NULL);
@@ -942,7 +943,6 @@ int __maybe_unused npu_suspend(struct device *dev)
 		return ret;
 	}
 	memset(engine->host_node, 0, sizeof(host_node_t));
-
 	engine->tiktok = 0;
 
 	npu_uninit_mbox(nvdla_dev);
@@ -975,8 +975,11 @@ int __maybe_unused npu_resume(struct device *dev)
 	int ret;
 	int is_enable = 0;
 	struct nvdla_device *ndev = dev_get_drvdata(dev);
-
 	dev_dbg(dev, "%s\n", __func__);
+	if(ndev->is_suspend == false) {
+		dla_error("%s, NPU was not suspended at last time.\n", __func__);
+		return -EACCES;
+	}
 
 	if ((NULL != ndev->npu_regulator) && (!IS_ERR(ndev->npu_regulator)))
 	{
@@ -1038,6 +1041,8 @@ int __maybe_unused npu_resume(struct device *dev)
 		npu_tbu_power(dev, false);
 	}
 
+	ndev->is_suspend = false;
+	npu_frame_schedule((struct win_engine *)ndev->win_engine);
 	return 0;
 
 err_ipc:
diff --git a/drivers/soc/eswin/ai_driver/npu/scheduler.c b/drivers/soc/eswin/ai_driver/npu/scheduler.c
index bb4f0931fd06..e0b4d20db85f 100644
--- a/drivers/soc/eswin/ai_driver/npu/scheduler.c
+++ b/drivers/soc/eswin/ai_driver/npu/scheduler.c
@@ -69,8 +69,7 @@ static int send_frame_to_hw(struct win_engine *engine, u8 tiktok,
 		(program_node_t *)host_node->program_base_addr;
 	u8 param = tiktok | ((engine->perf_switch) ? 0x02 : 0x0);
 	msg_payload_t payload = { FRAME_READY, param };
-	memcpy(&pemission_node->frame_desc[tiktok], frame_desc,
-	       sizeof(hetero_ipc_frame_t));
+	memcpy(&pemission_node->frame_desc[tiktok], frame_desc, sizeof(hetero_ipc_frame_t));
 	memcpy(program_node->io_addr_list[tiktok].tensor_addr,
 	       io_tensor->tensor_addr, sizeof(io_tensor->tensor_addr));
 
@@ -146,6 +145,7 @@ void npu_frame_schedule(struct win_engine *engine)
 	unsigned long flags;
 	bool ret;
 
+	struct nvdla_device *ndev = (struct nvdla_device *)engine->nvdla_dev;
 	while (true) {
 		spin_lock_irqsave(&engine->executor_lock, flags);
 		if (atomic_read(&engine->is_sending) ||
@@ -153,7 +153,10 @@ void npu_frame_schedule(struct win_engine *engine)
 			spin_unlock_irqrestore(&engine->executor_lock, flags);
 			break;
 		}
-
+		if (ndev->is_suspend == true) {
+			spin_unlock_irqrestore(&engine->executor_lock, flags);
+			break;
+		}
 		pick_next_frame(engine, &f);
 		if (f == NULL) {
 			spin_unlock_irqrestore(&engine->executor_lock, flags);
-- 
2.53.0

