+	if ((ctl->inst_cnt <= 0) || (ctl->inst_cnt > FAN_PWM_CHAN_CNT)) {
+		dev_err(dev, "%s():line%d error inst_cnt=%d\n",
+			__func__, __LINE__, ctl->inst_cnt);
+		return -EINVAL;
+	}
