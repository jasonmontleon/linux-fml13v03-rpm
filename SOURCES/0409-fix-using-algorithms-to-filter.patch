+	ret = of_property_read_u32(np, "pwm-minimum-period", &ctl->min_period);
+	if (ret) {
+		dev_err(dev, "%s():line%d read pwm-minimum-period error, ret=%d\n",
+			__func__, __LINE__, ret);
+		return ret;
+	}
