From ca11b9e8792488fbcc04981d7ee0e8b1d54c93ff Mon Sep 17 00:00:00 2001
From: sandiecao <sandie.cao@deepcomputing.io>
Date: Mon, 29 Sep 2025 14:29:22 +0800
Subject: [PATCH 446/540] WIN2030-19417:feat:npu suspend if npu status is free.

Changelogs:
1.npu suspend if npu status is free.

Change-Id: Iebabebc74c316ca283a9c8703169b5f5af062460
Signed-off-by: zhuxuefei <zhuxuefei@eswincomputing.com>
---
 drivers/soc/eswin/ai_driver/npu/npu_main.c  | 3 +++
 drivers/soc/eswin/ai_driver/npu/scheduler.c | 3 +++
 2 files changed, 6 insertions(+)

diff --git a/drivers/soc/eswin/ai_driver/npu/npu_main.c b/drivers/soc/eswin/ai_driver/npu/npu_main.c
index 84fb77bff04d3..1ec3e43813929 100644
--- a/drivers/soc/eswin/ai_driver/npu/npu_main.c
+++ b/drivers/soc/eswin/ai_driver/npu/npu_main.c
@@ -935,6 +935,9 @@ int __maybe_unused npu_suspend(struct device *dev)
 	int is_enable = 0;
 	int ret = 0;
 	nvdla_dev->is_suspend = true;
+	wait_event_interruptible_timeout(nvdla_dev->event_wq,
+		((engine->tiktok_frame[0] == NULL) && (engine->tiktok_frame[1] == NULL)),
+		msecs_to_jiffies(200));
 
 	dev_dbg(dev, "%s\n", __func__);
 	ret = npu_hardware_reset(NULL);
diff --git a/drivers/soc/eswin/ai_driver/npu/scheduler.c b/drivers/soc/eswin/ai_driver/npu/scheduler.c
index e0b4d20db85f2..6e14b3d978ccb 100644
--- a/drivers/soc/eswin/ai_driver/npu/scheduler.c
+++ b/drivers/soc/eswin/ai_driver/npu/scheduler.c
@@ -305,6 +305,9 @@ void mbx_irq_frame_done(struct win_engine *priv, u32 tiktok, u32 stat)
 	}
 	spin_lock_irqsave(&engine->executor_lock, flags);
 	engine->tiktok_frame[f->tiktok] = NULL;
+	if (engine->tiktok_frame[(f->tiktok + 1) % NUM_TIKTOK] == NULL) {
+		wake_up_interruptible(&ndev->event_wq);
+	}
 	unset_current(engine, executor, f->tiktok);
 	spin_unlock_irqrestore(&engine->executor_lock, flags);
 	npu_frame_done_process(f);
-- 
2.53.0

