From 756060269010c602c6acb47dde394a14ba5e4cd3 Mon Sep 17 00:00:00 2001
From: denglei <denglei@eswincomputing.com>
Date: Thu, 24 Apr 2025 15:43:26 +0800
Subject: [PATCH 346/540] fix:Resolve the issue of NPU reset.

Changelogs:
	Running the model after NPU reset causes SMMU SYNC timeout.

Signed-off-by: denglei <denglei@eswincomputing.com>
---
 drivers/soc/eswin/ai_driver/npu/nvdla_hw.c | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/drivers/soc/eswin/ai_driver/npu/nvdla_hw.c b/drivers/soc/eswin/ai_driver/npu/nvdla_hw.c
index 673f1ad67669a..c234930b28717 100644
--- a/drivers/soc/eswin/ai_driver/npu/nvdla_hw.c
+++ b/drivers/soc/eswin/ai_driver/npu/nvdla_hw.c
@@ -538,6 +538,8 @@ static ssize_t store_reset_hand(struct device *d, struct device_attribute *attr,
 
 			engine->tiktok = 0;
 
+			edma_free(nvdla_dev);
+
 			ret = npu_hardware_reset(nvdla_dev);
 			if (ret) {
 				dla_error("hardware reset err, ret=%d.\n", ret);
@@ -597,11 +599,16 @@ static ssize_t store_reset_hand(struct device *d, struct device_attribute *attr,
 				dla_error("e31 not bootup, error.\n");
 				goto exit;
 			}
+
+			ret = edma_init(nvdla_dev);
+			if (ret) {
+				dla_error("edma_init fail\n");
+				goto exit;
+			}
 			engine->engine_is_alive = true;
 		} else {
 			dla_error("err:input err.\n");
 		}
-		goto exit;
 	}
 
 exit:
-- 
2.53.0

