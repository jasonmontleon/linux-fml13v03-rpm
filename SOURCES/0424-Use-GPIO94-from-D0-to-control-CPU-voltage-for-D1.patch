From 2f648affe615cbdd2c9df440d45e65cc57ad28ab Mon Sep 17 00:00:00 2001
From: cheney <11722200@qq.com>
Date: Mon, 14 Jul 2025 18:05:02 +0800
Subject: [PATCH 424/540] Use GPIO94 from D0 to control CPU voltage for D1.

---
 arch/riscv/boot/dts/eswin/eic7702-deepcomputing-fml13v03.dts | 4 +---
 1 file changed, 1 insertion(+), 3 deletions(-)

diff --git a/arch/riscv/boot/dts/eswin/eic7702-deepcomputing-fml13v03.dts b/arch/riscv/boot/dts/eswin/eic7702-deepcomputing-fml13v03.dts
index ba0a9cea46bd7..13d48a90815ed 100644
--- a/arch/riscv/boot/dts/eswin/eic7702-deepcomputing-fml13v03.dts
+++ b/arch/riscv/boot/dts/eswin/eic7702-deepcomputing-fml13v03.dts
@@ -312,9 +312,7 @@ &d0_clock {
 
 &d1_clock {
 	status = "okay";
-	pinctrl-names = "default";
-	pinctrl-0 = <&pinctrl_die1_gpio104_default>;
-	cpu-voltage-gpios = <&portd 8 GPIO_ACTIVE_HIGH>;
+	cpu-voltage-gpios = <&portc 30 GPIO_ACTIVE_HIGH>;
 	cpu-default-frequency = <CLK_FREQ_1800M>;
 };
 
