 drivers/clk/eswin/clk.h                       |  1 +
 3 files changed, 51 insertions(+), 63 deletions(-)

diff --git a/arch/riscv/boot/dts/eswin/eic770x-opptable.dtsi b/arch/riscv/boot/dts/eswin/eic770x-opptable.dtsi
