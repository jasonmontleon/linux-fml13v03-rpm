+				clk->numa_id, cpu_target_volatge == VOLTAGE_0_9V?"high":"low", rate);
+ 	}
 
 	/*first disable pll */
 	val = readl_relaxed(clk->ctrl_reg0);
@@ -554,6 +548,9 @@ static unsigned long clk_pll_recalc_rate(struct clk_hw *hw,
 		case 200:
