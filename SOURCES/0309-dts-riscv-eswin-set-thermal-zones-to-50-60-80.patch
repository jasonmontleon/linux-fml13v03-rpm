From 2be16c49942f1e09a03b38e03ec800a4c34228bc Mon Sep 17 00:00:00 2001
From: Sandie Cao <sandie.cao@deepcomputing.io>
Date: Tue, 3 Jun 2025 14:04:44 +0800
Subject: [PATCH 309/540] dts: riscv: eswin: set thermal-zones to 50/60/80

Signed-off-by: Sandie Cao <sandie.cao@deepcomputing.io>
---
 arch/riscv/boot/dts/eswin/eswin-win2030-die0-soc.dtsi | 4 ++--
 arch/riscv/boot/dts/eswin/eswin-win2030-die1-soc.dtsi | 4 ++--
 2 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/arch/riscv/boot/dts/eswin/eswin-win2030-die0-soc.dtsi b/arch/riscv/boot/dts/eswin/eswin-win2030-die0-soc.dtsi
index 7b5a3aa9311d7..7dcb5bb5e719c 100644
--- a/arch/riscv/boot/dts/eswin/eswin-win2030-die0-soc.dtsi
+++ b/arch/riscv/boot/dts/eswin/eswin-win2030-die0-soc.dtsi
@@ -43,12 +43,12 @@ thermal0 {
 			trips {
 
 				threshold: trip-point0 {
-					temperature = <60000>;
+					temperature = <50000>;
 					hysteresis = <1000>;
 					type = "passive";
 				};
 				target: trip-point1 {
-					temperature = <70000>;
+					temperature = <60000>;
 					hysteresis = <1000>;
 					type = "passive";
 				};
diff --git a/arch/riscv/boot/dts/eswin/eswin-win2030-die1-soc.dtsi b/arch/riscv/boot/dts/eswin/eswin-win2030-die1-soc.dtsi
index f8b2f3751f21c..76b59bc65d54e 100644
--- a/arch/riscv/boot/dts/eswin/eswin-win2030-die1-soc.dtsi
+++ b/arch/riscv/boot/dts/eswin/eswin-win2030-die1-soc.dtsi
@@ -40,12 +40,12 @@ d1_thermal0 {
 
 			trips {
 				d1_threshold: trip-point0 {
-					temperature = <60000>;
+					temperature = <50000>;
 					hysteresis = <1000>;
 					type = "passive";
 				};
 				d1_target: trip-point1 {
-					temperature = <70000>;
+					temperature = <60000>;
 					hysteresis = <1000>;
 					type = "passive";
 				};
-- 
2.53.0

