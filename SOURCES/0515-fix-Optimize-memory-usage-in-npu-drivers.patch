From a4d74f5f12ccb898e7c090461e8d3cf80296d66d Mon Sep 17 00:00:00 2001
From: denglei <denglei@eswincomputing.com>
Date: Tue, 2 Sep 2025 10:35:13 +0800
Subject: [PATCH 515/540] fix:Optimize memory usage in npu drivers.

Changelogs:
	1.reduce NPU driver requests for continuous memory.
	2.modify the npu code format.

Signed-off-by: denglei <denglei@eswincomputing.com>
---
 drivers/soc/eswin/ai_driver/dsp/dsp_main.h   | 12 ++++++------
 drivers/soc/eswin/ai_driver/npu/dla_buffer.c |  3 +++
 drivers/soc/eswin/ai_driver/npu/engine.c     | 11 ++++++++---
 3 files changed, 17 insertions(+), 9 deletions(-)

diff --git a/drivers/soc/eswin/ai_driver/dsp/dsp_main.h b/drivers/soc/eswin/ai_driver/dsp/dsp_main.h
index ac6e04357adf..77d7017ba765 100644
--- a/drivers/soc/eswin/ai_driver/dsp/dsp_main.h
+++ b/drivers/soc/eswin/ai_driver/dsp/dsp_main.h
@@ -114,11 +114,11 @@ struct prio_array {
 
 struct es_dsp_stats {
 	char *last_op_name;
-	int total_ok_cnt;
-	int total_failed_cnt;
-	int total_int_cnt;
-	int send_to_dsp_cnt;
-	int task_timeout_cnt;
+	u32 total_ok_cnt;
+	u32 total_failed_cnt;
+	u32 total_int_cnt;
+	u32 send_to_dsp_cnt;
+	u32 task_timeout_cnt;
 	u64 last_task_time;
 };
 
@@ -207,7 +207,7 @@ struct es_dsp {
 
 #define DSP_PTS_IOVA 0xfffb1000
 #define DSP_PTS_IOVA_SIZE 0x8000
-
+#define TIMER3_BASE_ADDR 0x51858000
 #define DSP_DEVICE_U84_TO_MCU_MBX ESWIN_MAILBOX_DSP_TO_E31_REG_BASE
 #define U84_TO_MCU_IOVA_SIZE 0x1000
 
diff --git a/drivers/soc/eswin/ai_driver/npu/dla_buffer.c b/drivers/soc/eswin/ai_driver/npu/dla_buffer.c
index 1db428181eed..9a5fca80aee1 100644
--- a/drivers/soc/eswin/ai_driver/npu/dla_buffer.c
+++ b/drivers/soc/eswin/ai_driver/npu/dla_buffer.c
@@ -307,7 +307,10 @@ int dla_import_dmabuf_from_model(struct user_model *model)
 			   i, bobjs[i].fd, dma_buf,
 			   dma_buf->file->f_count.counter);
 		bobjs[i].dmabuf = dma_buf;
+
+		mutex_lock(&nvdla_dev->mapping_mutex);
 		ret = dla_attach_dmabuf(&bobjs[i], &nvdla_dev->pdev->dev);
+		mutex_unlock(&nvdla_dev->mapping_mutex);
 		if (ret < 0) {
 			dla_error("err:dla_attach_dmabuf failed!\n");
 			dma_buf_put(dma_buf);
diff --git a/drivers/soc/eswin/ai_driver/npu/engine.c b/drivers/soc/eswin/ai_driver/npu/engine.c
index fe6d3c1339c8..0a29fbe5a158 100644
--- a/drivers/soc/eswin/ai_driver/npu/engine.c
+++ b/drivers/soc/eswin/ai_driver/npu/engine.c
@@ -164,6 +164,8 @@ int read_input_address(struct win_executor *executor,
 {
 	int32_t ret = ERR(INVALID_INPUT);
 
+	dla_debug("%s, %d, type=%d, index%d, offset:%d, size:%d.\n", __func__, __LINE__,
+			  data->type, data->address, data->offset, data->size);
 	/**
 	 * If memory type is HW then no address required
 	 */
@@ -368,6 +370,9 @@ static void npu_task_complete_work(struct work_struct *work)
 		if (f->dump_dtim) {
 			dump_dtim_to_file(engine, f->tiktok);
 		}
+		if(f->hw_error) {
+			dla_error("execute frame encounter hw error:0x%x\n", f->hw_error);
+		}
 		kernel_handle_decref(&f->handle);
 	}
 }
@@ -820,7 +825,7 @@ int create_executor(struct dla_task *task, struct dla_network_desc *network,
 	struct win_executor *executor;
 	int ret, i;
 
-	executor = kzalloc(sizeof(struct win_executor), GFP_KERNEL);
+	executor = vzalloc(sizeof(struct win_executor));
 	if (executor == NULL) {
 		dla_error("%s %d no mem\n", __func__, __LINE__);
 		return -ENOMEM;
@@ -895,7 +900,7 @@ int create_executor(struct dla_task *task, struct dla_network_desc *network,
 err_free1:
 	vfree(executor->dependency_count);
 err_free0:
-	kfree(executor);
+	vfree(executor);
 	*m_executor = NULL;
 	return ret;
 }
@@ -930,6 +935,6 @@ void executor_clearup(void *arg_executor)
 	dsp_resource_destroy(executor);
 	free_executor_tensor_data(executor);
 
-	kfree(executor);
+	vfree(executor);
 	dla_debug("%s, %d. done.\n", __func__, __LINE__);
 }
-- 
2.54.0

