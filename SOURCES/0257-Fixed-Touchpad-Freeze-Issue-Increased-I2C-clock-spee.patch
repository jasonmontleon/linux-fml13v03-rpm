From 5b74a50464a2776c2563ca4fb5524b8564386ac2 Mon Sep 17 00:00:00 2001
From: cheney <11722200@qq.com>
Date: Wed, 26 Mar 2025 12:50:44 +0800
Subject: [PATCH 257/533] Fixed Touchpad Freeze Issue: Increased I2C clock
 speed from 100KHz to 400KHz to resolve the problem.

---
 arch/riscv/boot/dts/eswin/eic7702-deepcomputing-fml13v03.dts | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/arch/riscv/boot/dts/eswin/eic7702-deepcomputing-fml13v03.dts b/arch/riscv/boot/dts/eswin/eic7702-deepcomputing-fml13v03.dts
index 1ebbfeff875b..eed7c1addd49 100644
--- a/arch/riscv/boot/dts/eswin/eic7702-deepcomputing-fml13v03.dts
+++ b/arch/riscv/boot/dts/eswin/eic7702-deepcomputing-fml13v03.dts
@@ -1344,6 +1344,7 @@ d1_npu_vcc: npu_svcc {
 
 &d0_i2c2 {
 	status = "ok";
+	clock-frequency = <I2C_BITRATE_FAST>;
 
 	d0_touchpad: hid@2c {
 		/* touch pad*/
@@ -1355,7 +1356,6 @@ d0_touchpad: hid@2c {
 		interrupts = <20 IRQ_TYPE_LEVEL_LOW>;
 		pinctrl-names = "default";
 		pinctrl-0 = <&pinctrl_die0_gpio20_default>;
-		irq-gpios = <&porta 20 GPIO_ACTIVE_LOW>;
 		status = "okay";
 	};
 
-- 
2.51.1

