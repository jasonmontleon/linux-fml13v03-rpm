From c166585e01bffc1aef467b2e9057c7ad259e324d Mon Sep 17 00:00:00 2001
From: cheney <11722200@qq.com>
Date: Mon, 4 Aug 2025 15:09:42 +0800
Subject: [PATCH 425/534] dts: Add EEPROM device node to enable SN retrieval

---
 .../dts/eswin/eic7702-deepcomputing-fml13v03.dts  | 15 ++++++++++++++-
 1 file changed, 14 insertions(+), 1 deletion(-)

diff --git a/arch/riscv/boot/dts/eswin/eic7702-deepcomputing-fml13v03.dts b/arch/riscv/boot/dts/eswin/eic7702-deepcomputing-fml13v03.dts
index e42af9a633301..d594bdeff7efc 100644
--- a/arch/riscv/boot/dts/eswin/eic7702-deepcomputing-fml13v03.dts
+++ b/arch/riscv/boot/dts/eswin/eic7702-deepcomputing-fml13v03.dts
@@ -160,6 +160,14 @@ distance-map {
 				<1 1 10>;
 	};
 
+	dummy_3v3: regulator-dummy {
+		compatible = "regulator-fixed";
+		regulator-name = "dummy";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		regulator-always-on;
+	};
+
 	backlight_regulator: regulator-backlight {
 		compatible = "regulator-fixed";
 		regulator-name = "backlight-power";
@@ -1501,9 +1509,14 @@ tmp102@48 {
 		label = "d0_board_tmp";
 		#thermal-sensor-cells = <1>;
 	};
+	eeprom@50 {
+		compatible = "atmel,24c02";
+		reg = <0x50>;
+		pagesize = <8>;
+		vcc-supply = <&dummy_3v3>;
+	};
 };
 
-
 &d1_aon_i2c0 {
 	/* ina226x4 */
 	status = "okay";
-- 
2.53.0

