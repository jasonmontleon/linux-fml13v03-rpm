From c2add75770e9eeb13ae3116b4e1465dd4bd14df4 Mon Sep 17 00:00:00 2001
From: "yang.wang" <yang.wang@deepcomputing.io>
Date: Thu, 3 Jul 2025 16:32:58 +0800
Subject: [PATCH 416/540] drm/eswin: Add support for 1920x1200 and 2560x1600
 display modes.

Signed-off-by: yang.wang <yang.wang@deepcomputing.io>
---
 drivers/gpu/drm/eswin/dw-hdmi.c    |  5 ++++-
 drivers/gpu/drm/eswin/es_dw_hdmi.c | 12 ++++++++++++
 2 files changed, 16 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/eswin/dw-hdmi.c b/drivers/gpu/drm/eswin/dw-hdmi.c
index 66378eabf5dd..05e8495d6c5e 100644
--- a/drivers/gpu/drm/eswin/dw-hdmi.c
+++ b/drivers/gpu/drm/eswin/dw-hdmi.c
@@ -3372,7 +3372,10 @@ dw_hdmi_bridge_mode_valid(struct drm_bridge *bridge,
 		return MODE_NO_INTERLACE;
 
 	if (hdmi->numa_id == 0) {
-		if (mode->clock != 235690 && mode->clock != 371370)
+		if (mode->clock != 235690 &&	// 2.2K: 2256x1504
+			mode->clock != 371370 &&	// 2.8K: 2880x1800
+		    mode->clock != 154120 &&	// 1920x1200
+		    mode->clock != 277440)		// 2.5K: 2560x1600
 			return MODE_BAD;
 	}
 
diff --git a/drivers/gpu/drm/eswin/es_dw_hdmi.c b/drivers/gpu/drm/eswin/es_dw_hdmi.c
index a58a0094bc86..aa8b7ed373fc 100644
--- a/drivers/gpu/drm/eswin/es_dw_hdmi.c
+++ b/drivers/gpu/drm/eswin/es_dw_hdmi.c
@@ -151,6 +151,14 @@ static const struct dw_hdmi_mpll_config eswin_mpll_cfg[] = {
 			{ 0x2648, 0x020f },
 		},
 	},
+	{
+		277440000,
+		{
+			{ 0x0000, 0x0605 },
+			{ 0x1018, 0x0219 },
+			{ 0x2648, 0x020f },
+		},
+	},
 	{
 		297000000,
 		{
@@ -219,6 +227,10 @@ static const struct dw_hdmi_curr_ctrl eswin_cur_ctr[] = {
 		235690000,
 		{ 0x3040, 0x3182, 0x3100 },
 	},
+	{
+		277440000,
+		{ 0x3041, 0x3182, 0x3100 },
+	},
 	{
 		297000000,
 		{ 0x3041, 0x3182, 0x3100 },
-- 
2.54.0

