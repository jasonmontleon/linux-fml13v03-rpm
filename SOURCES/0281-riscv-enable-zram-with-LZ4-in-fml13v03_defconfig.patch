From 053ab62c741acc8e5932e865bd528a7febddfebd Mon Sep 17 00:00:00 2001
From: "yang.wang" <yang.wang@deepcomputing.io>
Date: Thu, 24 Apr 2025 14:30:10 +0800
Subject: [PATCH 281/533] riscv: enable zram with LZ4 in fml13v03_defconfig

Signed-off-by: yang.wang <yang.wang@deepcomputing.io>
---
 arch/riscv/configs/fml13v03_defconfig | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/arch/riscv/configs/fml13v03_defconfig b/arch/riscv/configs/fml13v03_defconfig
index a0311d75cad2..214a1b6fb678 100755
--- a/arch/riscv/configs/fml13v03_defconfig
+++ b/arch/riscv/configs/fml13v03_defconfig
@@ -327,6 +327,8 @@ CONFIG_RESET_ATTACK_MITIGATION=y
 CONFIG_EFI_COCO_SECRET=y
 CONFIG_MTD=y
 CONFIG_MTD_SPI_NOR=y
+CONFIG_ZRAM=m
+CONFIG_ZRAM_DEF_COMP_LZ4=y
 CONFIG_BLK_DEV_LOOP=y
 CONFIG_BLK_DEV_RAM=y
 CONFIG_BLK_DEV_RAM_COUNT=2
@@ -853,6 +855,11 @@ CONFIG_CRYPTO_ECB=m
 CONFIG_CRYPTO_HMAC=m
 CONFIG_CRYPTO_MD5=y
 CONFIG_CRYPTO_SHA512=m
+CONFIG_CRYPTO_LZO=m
+CONFIG_CRYPTO_842=m
+CONFIG_CRYPTO_LZ4=m
+CONFIG_CRYPTO_LZ4HC=m
+CONFIG_CRYPTO_ZSTD=m
 CONFIG_CRYPTO_DEV_VIRTIO=y
 CONFIG_CRYPTO_DEV_ESWIN_EIC770x=y
 CONFIG_CRC_ITU_T=y
-- 
2.52.0

