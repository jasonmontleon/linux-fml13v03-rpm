From 8745c96d93413077de6fd5329c86ebe96319668d Mon Sep 17 00:00:00 2001
From: yufangxian <yufangxian@eswincomputing.com>
Date: Wed, 14 May 2025 18:21:01 +0800
Subject: [PATCH 360/533] fix: fix dc endpoint index

Changelogs:
1. fix dc endpoint index changed by last vi merge

Signed-off-by: yufangxian <yufangxian@eswincomputing.com>
---
 arch/riscv/boot/dts/eswin/eic7700-hifive-premier-p550.dts | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/arch/riscv/boot/dts/eswin/eic7700-hifive-premier-p550.dts b/arch/riscv/boot/dts/eswin/eic7700-hifive-premier-p550.dts
index 8d2ad1b263c7..2b22b12ab389 100644
--- a/arch/riscv/boot/dts/eswin/eic7700-hifive-premier-p550.dts
+++ b/arch/riscv/boot/dts/eswin/eic7700-hifive-premier-p550.dts
@@ -308,12 +308,12 @@ &dc {
 	dc_out: port {
 		#address-cells = <1>;
 		#size-cells = <0>;
-		dc_out_dpi: endpoint@0 {
-			reg = <0>;
+		dc_out_dpi: endpoint@1 {
+			reg = <1>;
 			remote-endpoint = <&vd_input>;
 		};
-		dc_out_hdmi: endpoint@1 {
-			reg = <1>;
+		dc_out_hdmi: endpoint@2 {
+			reg = <2>;
 			remote-endpoint = <&hdmi_in_dc>;
 		};
 	};
-- 
