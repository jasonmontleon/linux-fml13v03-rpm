+
+static umode_t tps549d22_is_visible(const void *_data,
+				    enum hwmon_sensor_types type, u32 attr,
+				    int channel)
+{
+	switch (type) {
+	case hwmon_in:
+		switch (attr) {
+		case hwmon_in_label:
+		case hwmon_in_input:
+			return 0444;
+		case hwmon_in_enable:
+			return 0644;
+		}
+		break;
+	default:
+		break;
+	}
+	return 0;
+}
+
+static int tps549d22_read(struct device *dev, enum hwmon_sensor_types type,
+			  u32 attr, int channel, long *val)
+{
+	struct i2c_client *client = to_i2c_client(dev);
+	struct TPS549D22_DRIVER_DATA *data = i2c_get_clientdata(client);
+
+	switch (type) {
+	case hwmon_in:
+		switch (attr) {
+		case hwmon_in_input:
+			*val = tps549d22_get_vout(data);
+			break;
+		case hwmon_in_enable:
+			*val = tps549d22_get_enable(data);
+			break;
+		}
+		break;
+	default:
+		break;
+	}
+	return 0;
+}
+
+static int tps549d22_write(struct device *dev, enum hwmon_sensor_types type,
+			   u32 attr, int channel, long val)
+{
+	struct i2c_client *client = to_i2c_client(dev);
+	struct TPS549D22_DRIVER_DATA *data = i2c_get_clientdata(client);
+	int ret = 0;
+
+	switch (type) {
+	case hwmon_in:
+		switch (attr) {
+		case hwmon_in_enable:
+			tps549d22_update_byte(data, TPS549D22_CMD_OPERATION,
+					      TPS549D22_MASK_OPERATION_ENABLE,
+					      (u8)((val & 0x1) << 7));
+			break;
+		}
+		break;
+	default:
+		break;
+	}
+	return ret;
+}
+static int tps549d22_read_string(struct device *dev,
+				 enum hwmon_sensor_types type, u32 attr,
+				 int channel, const char **str)
+{
+	struct i2c_client *client = to_i2c_client(dev);
+	struct TPS549D22_DRIVER_DATA *data = i2c_get_clientdata(client);
+	switch (type) {
+	case hwmon_in:
+		switch (attr) {
+		case hwmon_in_label:
+			if (channel == 0) {
+				*str = data->tps549d22_label[0];
+			} else if (channel == 1) {
+				*str = data->tps549d22_label[1];
+			} else {
+				dev_err(dev, "not support channel%d\n",
+					channel);
+			}
+			break;
+		}
+		break;
+	default:
+		break;
+	}
+	return 0;
+}
