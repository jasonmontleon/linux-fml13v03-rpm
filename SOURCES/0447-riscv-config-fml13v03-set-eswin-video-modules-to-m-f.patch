From bc1ca6ce877488eed9af294c29b8e487c35caa8b Mon Sep 17 00:00:00 2001
From: sandiecao <sandie.cao@deepcomputing.io>
Date: Mon, 29 Sep 2025 15:50:45 +0800
Subject: [PATCH 447/540] riscv: config: fml13v03: set eswin video modules to m
 for saving boot time

Signed-off-by: sandiecao <sandie.cao@deepcomputing.io>
---
 arch/riscv/configs/fml13v03_defconfig | 10 +++++-----
 1 file changed, 5 insertions(+), 5 deletions(-)

diff --git a/arch/riscv/configs/fml13v03_defconfig b/arch/riscv/configs/fml13v03_defconfig
index 1c6fb350f565a..d91e28ec1c26d 100755
--- a/arch/riscv/configs/fml13v03_defconfig
+++ b/arch/riscv/configs/fml13v03_defconfig
@@ -3652,11 +3652,11 @@ CONFIG_AD9834=m
 CONFIG_AD5933=m
 CONFIG_STAGING_MEDIA=y
 CONFIG_VIDEO_ESWIN=y
-CONFIG_VIDEO_ESWIN_VDEC=y
-CONFIG_VIDEO_ESWIN_VENC=y
-CONFIG_VIDEO_ESWIN_HAE=y
-CONFIG_VIDEO_ESWIN_DEWARP=y
-CONFIG_VIDEO_ESWIN_MEDIA_EXT_DRIVER=y
+CONFIG_VIDEO_ESWIN_VDEC=m
+CONFIG_VIDEO_ESWIN_VENC=m
+CONFIG_VIDEO_ESWIN_HAE=m
+CONFIG_VIDEO_ESWIN_DEWARP=m
+CONFIG_VIDEO_ESWIN_MEDIA_EXT_DRIVER=m
 CONFIG_LTE_GDM724X=m
 CONFIG_FB_TFT=m
 CONFIG_FB_TFT_AGM1264K_FL=m
