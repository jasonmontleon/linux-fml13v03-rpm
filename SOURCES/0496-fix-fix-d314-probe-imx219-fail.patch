From 318abc895ed03c9c38acd9a5719f46587a4bcd06 Mon Sep 17 00:00:00 2001
From: yufangxian <yufangxian@eswincomputing.com>
Date: Mon, 1 Sep 2025 13:42:37 +0800
Subject: [PATCH 496/540] fix: fix d314 probe imx219 fail

Changelogs:
1. change d314 camera dts to fix imx219 probe fail

Signed-off-by: yufangxian <yufangxian@eswincomputing.com>
---
 .../boot/dts/eswin/eic7700-d314-camera.dtsi   | 34 ++++++++++++-------
 drivers/phy/eswin/phy-eswin-csi2-dphy-hw.c    |  2 +-
 2 files changed, 22 insertions(+), 14 deletions(-)

diff --git a/arch/riscv/boot/dts/eswin/eic7700-d314-camera.dtsi b/arch/riscv/boot/dts/eswin/eic7700-d314-camera.dtsi
index 728bdb9436f3..0c8ba0f47cfc 100644
--- a/arch/riscv/boot/dts/eswin/eic7700-d314-camera.dtsi
+++ b/arch/riscv/boot/dts/eswin/eic7700-d314-camera.dtsi
@@ -127,12 +127,10 @@ camera_imx219: camera-imx219@10 {
 				compatible = "sony,imx219";
 				reg = <0x10>;
 
-				//clocks = <&clk_cam_24m>;
-				//clock-names = "xvclk";
-				pinctrl-names = "default";
-				pinctrl-0 = <&pinctrl_gpio72_default>;
-				mclk-gpios = <&portc 8 GPIO_ACTIVE_HIGH>;
-				xvs-gpios = <&portc 6 GPIO_ACTIVE_HIGH>;
+				clocks = <&d0_clock EIC7700_CLK_VI_SHUTTER_0>;
+				assigned-clocks = <&d0_clock EIC7700_CLK_VI_SHUTTER_0>;
+				assigned-clock-rates = <24000000>;
+				clock-names = "xvclk";
 
 				port {
 					imx219_out0: endpoint {
@@ -154,8 +152,11 @@ camera_imx219_1: camera-imx219@10 {
 				compatible = "sony,imx219";
 				reg = <0x10>;
 
-				//clocks = <&clk_cam_24m>;
-				//clock-names = "xvclk";
+				clocks = <&d0_clock EIC7700_CLK_VI_SHUTTER_0>;
+				assigned-clocks = <&d0_clock EIC7700_CLK_VI_SHUTTER_0>;
+				assigned-clock-rates = <24000000>;
+				clock-names = "xvclk";
+
 
 				port {
 					imx219_out1: endpoint {
@@ -177,8 +178,10 @@ camera_imx219_2: camera-imx219@10 {
 				compatible = "sony,imx219";
 				reg = <0x10>;
 
-				//clocks = <&clk_cam_24m>;
-				//clock-names = "xvclk";
+				clocks = <&d0_clock EIC7700_CLK_VI_SHUTTER_0>;
+				assigned-clocks = <&d0_clock EIC7700_CLK_VI_SHUTTER_0>;
+				assigned-clock-rates = <24000000>;
+				clock-names = "xvclk";
 
 				port {
 					imx219_out2: endpoint {
@@ -200,8 +203,10 @@ camera_imx219_3: camera-imx219@10 {
 				compatible = "sony,imx219";
 				reg = <0x10>;
 
-				//clocks = <&clk_cam_24m>;
-				//clock-names = "xvclk";
+				clocks = <&d0_clock EIC7700_CLK_VI_SHUTTER_0>;
+				assigned-clocks = <&d0_clock EIC7700_CLK_VI_SHUTTER_0>;
+				assigned-clock-rates = <24000000>;
+				clock-names = "xvclk";
 
 				port {
 					imx219_out3: endpoint {
@@ -216,9 +221,9 @@ imx219_out3: endpoint {
 	};
 };
 
-
 &csi2_dphy_hw {
 	lanes = <1 2>;
+	lanes-dp-dn = <0 0>;
 	status = "disabled";
 };
 
@@ -255,6 +260,7 @@ csidphy0_out: endpoint@1 {
 
 &csi2_dphy_hw1 {
 	lanes = <1 2>;
+	lanes-dp-dn = <0 0>;
 	status = "disabled";
 };
 &csi2_dphy1 {
@@ -290,6 +296,7 @@ csidphy1_out: endpoint@1 {
 
 &csi2_dphy_hw2 {
 	lanes = <1 2>;
+	lanes-dp-dn = <0 0>;
 	status = "disabled";
 };
 &csi2_dphy2 {
@@ -325,6 +332,7 @@ csidphy2_out: endpoint@1 {
 
 &csi2_dphy_hw3 {
 	lanes = <1 2>;
+	lanes-dp-dn = <0 0>;
 	status = "disabled";
 };
 &csi2_dphy3 {
diff --git a/drivers/phy/eswin/phy-eswin-csi2-dphy-hw.c b/drivers/phy/eswin/phy-eswin-csi2-dphy-hw.c
index 8bb690c43599..038eb3a8d466 100644
--- a/drivers/phy/eswin/phy-eswin-csi2-dphy-hw.c
+++ b/drivers/phy/eswin/phy-eswin-csi2-dphy-hw.c
@@ -842,7 +842,7 @@ static int eswin_csi2_dphy_hw_probe(struct platform_device *pdev)
 	} else {
 		ret = of_property_read_u32_array(dev->of_node, "lanes-dp-dn", dphy_hw->lanes_dp_dn, dphy_hw->num_lanes);
 		if (ret) {
-			dev_err(dev, "Failed to read lanes array\n");
+			dev_err(dev, "Failed to read lanes dn-dp array\n");
 			return ret;
 		}
 	}
