 drivers/pwm/pwm-dwc-eswin.c                                 | 6 ++++++
 2 files changed, 7 insertions(+), 1 deletion(-)

diff --git a/arch/riscv/boot/dts/eswin/eic7702-deepcomputing-fml13v03.dts b/arch/riscv/boot/dts/eswin/eic7702-deepcomputing-fml13v03.dts
index 98d2a3769173..1d77fad613da 100644
--- a/arch/riscv/boot/dts/eswin/eic7702-deepcomputing-fml13v03.dts
+++ b/arch/riscv/boot/dts/eswin/eic7702-deepcomputing-fml13v03.dts
@@ -1579,7 +1579,7 @@ &d1_pwm0 {
 	pinctrl-names = "default";
 	pinctrl-0 = <&pinctrl_die1_pwm0_default>;
 	pinctrl-1 = <&pinctrl_die1_gpio68_default>;
-	enable-gpios = <&d1_portc 4 GPIO_ACTIVE_HIGH>;
+	fan-gpios = <&d1_portc 4 GPIO_ACTIVE_HIGH>;
 };
 
 &fan_control {
diff --git a/drivers/pwm/pwm-dwc-eswin.c b/drivers/pwm/pwm-dwc-eswin.c
index 8143b899cdad..d69372bd5e0a 100644
--- a/drivers/pwm/pwm-dwc-eswin.c
+++ b/drivers/pwm/pwm-dwc-eswin.c
@@ -103,6 +103,12 @@ static int __dwc_pwm_configure_timer(struct dwc_pwm *dwc,
 	u32 high=0;
 	u32 low=0;
 
+	if (duty >= state->period)
+		duty = state->period - DWC_CLK_PERIOD_NS;
+
+	if (duty == 0 && state->enabled)
+		duty = state->period / 2;
+
