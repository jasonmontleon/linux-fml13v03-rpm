From 042942e022b59754b87770350e75dcd337ad3c96 Mon Sep 17 00:00:00 2001
From: "yang.wang" <yang.wang@deepcomputing.io>
Date: Wed, 21 May 2025 10:30:40 +0800
Subject: [PATCH 301/540] dt-bindings: riscv: eswin: Add GPIO25 pinctrl and EC
 interrupt description for EIC7702

Signed-off-by: yang.wang <yang.wang@deepcomputing.io>
---
 .../dts/eswin/eic7702-deepcomputing-fml13v03.dts  | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/arch/riscv/boot/dts/eswin/eic7702-deepcomputing-fml13v03.dts b/arch/riscv/boot/dts/eswin/eic7702-deepcomputing-fml13v03.dts
index a93bdb2b01dca..39cb7f66eb2fa 100644
--- a/arch/riscv/boot/dts/eswin/eic7702-deepcomputing-fml13v03.dts
+++ b/arch/riscv/boot/dts/eswin/eic7702-deepcomputing-fml13v03.dts
@@ -526,6 +526,20 @@ &d1_lpcpu {
 	status = "disabled";
 };
 
+&pinctrl_die0_gpio25_default {
+	mux {
+		groups = "gpio25_group";
+		function = "gpio25_func";
+	};
+	conf {
+		groups = "gpio25_group";
+		drive-strength = <2>;
+		input-enable = <1>;
+		bias-pull-up = <0>;
+		bias-pull-down = <0>;
+	};
+};
+
 &pinctrl_die0_gpio27_default {
 	mux {
 		groups = "gpio27_group";
@@ -1716,6 +1730,7 @@ gpio15  : gphy0 resetn(O)
 	gpio18  : ina226 alert(I)
 	gpio20  : lcd touch int(I)
 	gpio21  : head phone plug/unplug detection2(I)
+	gpio25  : ec interrupt(I)
 	gpio27  : wifi power enable(O)
 	gpio28  : head phone plug/unplug detection1(I)
 	gpio68  : fan pwm(O)
-- 
2.53.0

