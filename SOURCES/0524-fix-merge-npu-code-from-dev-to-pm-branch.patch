 6 files changed, 27 insertions(+), 50 deletions(-)

diff --git a/arch/riscv/boot/dts/eswin/eic7702-d560a.dts b/arch/riscv/boot/dts/eswin/eic7702-d560a.dts
index 3adfef6dabb1..faf23835ece5 100644
