From e7342dc9c317b53d584d8409e8a499d1f48df656 Mon Sep 17 00:00:00 2001
From: guozeyang <guozeyang@eswincomputing.com>
Date: Tue, 26 Aug 2025 15:41:35 +0800
Subject: [PATCH 506/540] fix:add mipi device node for vela

Changelogs:
	add mipi device node

Signed-off-by: guozeyang <guozeyang@eswincomputing.com>
---
 arch/riscv/boot/dts/eswin/eic7700-vela.dts | 4 +++-
 arch/riscv/boot/dts/eswin/eic7700-z530.dts | 3 +++
 2 files changed, 6 insertions(+), 1 deletion(-)

diff --git a/arch/riscv/boot/dts/eswin/eic7700-vela.dts b/arch/riscv/boot/dts/eswin/eic7700-vela.dts
index f6d399c8a87f2..809400c9e436f 100644
--- a/arch/riscv/boot/dts/eswin/eic7700-vela.dts
+++ b/arch/riscv/boot/dts/eswin/eic7700-vela.dts
@@ -19,7 +19,7 @@
  */
 
 #include "eic7700-som260-a1.dtsi"
-#include "eic7700-vela-camera-imx415.dtsi"
+//#include "eic7700-vela-camera-imx415.dtsi"
 
 / {
 	#address-cells = <2>;
@@ -38,6 +38,7 @@ &d0_gmac0 {
 	pinctrl-names = "default";
 	pinctrl-0 = <&pinctrl_gpio80_default>;
 	rst-gpios = <&portc 16 GPIO_ACTIVE_LOW>;
+	phy-mode = "rgmii-txid";
 	dly-param-1000m = <0x23232323 0xa0209023 0x20202020>;
 	dly-param-100m = <0x50505050 0x803f8050 0x3f3f3f3f>;
 	dly-param-10m = <0 0 0>;
@@ -47,6 +48,7 @@ &d0_gmac1 {
 	pinctrl-names = "default";
 	pinctrl-0 = <&pinctrl_gpio81_default>;
 	rst-gpios = <&portc 17 GPIO_ACTIVE_LOW>;
+	phy-mode = "rgmii-txid";
 	dly-param-1000m = <0x00000000 0xe002e000 0x04040404>;
 	dly-param-100m = <0x48484848 0x80588048 0x58585858>;
 	dly-param-10m = <0 0 0>;
diff --git a/arch/riscv/boot/dts/eswin/eic7700-z530.dts b/arch/riscv/boot/dts/eswin/eic7700-z530.dts
index 5d022417d45f1..25642bd8dd88d 100644
--- a/arch/riscv/boot/dts/eswin/eic7700-z530.dts
+++ b/arch/riscv/boot/dts/eswin/eic7700-z530.dts
@@ -19,6 +19,7 @@
  */
 
 #include "eic7700-som260-a1.dtsi"
+#include "eic7700-z530-camera-lt6911uxe.dtsi"
 
 / {
 	#address-cells = <2>;
@@ -45,12 +46,14 @@ reg_vcc1v8: vcc1v8 {
 };
 
 &d0_gmac0 {
+	phy-mode = "rgmii-txid";
 	dly-param-1000m = <0x10101010 0x1D003410 0x0>;
 	dly-param-100m = <0x10101010 0x64104610 0x10101010>;
 	dly-param-10m = <0 0 0>;
 };
 
 &d0_gmac1 {
+	phy-mode = "rgmii-txid";
 	dly-param-1000m = <0x10101010 0x14102810 0x10101010>;
 	dly-param-100m = <0x10101010 0x3C102810 0x10101010>;
 	dly-param-10m = <0 0 0>;
-- 
