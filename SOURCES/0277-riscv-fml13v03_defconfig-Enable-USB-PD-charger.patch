From a8d41baf020edae4eef6a141e9311ae66aed17ba Mon Sep 17 00:00:00 2001
From: "yang.wang" <yang.wang@deepcomputing.io>
Date: Wed, 2 Apr 2025 17:37:28 +0800
Subject: [PATCH 277/540] riscv: fml13v03_defconfig: Enable USB PD charger

Signed-off-by: yang.wang <yang.wang@deepcomputing.io>
---
 arch/riscv/configs/fml13v03_defconfig | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/arch/riscv/configs/fml13v03_defconfig b/arch/riscv/configs/fml13v03_defconfig
index 98b2e2871be46..38396e7abdbfa 100755
--- a/arch/riscv/configs/fml13v03_defconfig
+++ b/arch/riscv/configs/fml13v03_defconfig
@@ -477,6 +477,7 @@ CONFIG_GPIOLIB=y
 CONFIG_GPIO_SYSFS=y
 CONFIG_GPIO_DWAPB=y
 CONFIG_BATTERY_CROS_SBS=m
+CONFIG_CHARGER_CROS_USBPD=m
 CONFIG_SENSORS_ESWIN_FAN_CONTROL=y
 CONFIG_SENSORS_ESWIN_PVT=y
 CONFIG_SENSORS_INA2XX=y
@@ -767,7 +768,6 @@ CONFIG_CROS_EC_SPI=m
 # CONFIG_CROS_EC_VBC is not set
 # CONFIG_CROS_EC_DEBUGFS is not set
 # CONFIG_CROS_EC_SENSORHUB is not set
-# CONFIG_CROS_USBPD_NOTIFY is not set
 CONFIG_CROS_EC_POWEROFF=m
 CONFIG_COMMON_CLK_EIC7700=y
 CONFIG_TIMER_ESWIN=y
-- 
2.53.0

