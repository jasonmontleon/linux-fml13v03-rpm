From 9abcd24b936ad45a7ce1b21f14ae1253e51ec7d2 Mon Sep 17 00:00:00 2001
From: "yang.wang" <yang.wang@deepcomputing.io>
Date: Thu, 27 Mar 2025 14:16:16 +0800
Subject: [PATCH 262/533] NPU: fix NPU startup hang issue.

Signed-off-by: yang.wang <yang.wang@deepcomputing.io>
---
 .../dts/eswin/eic7702-deepcomputing-fml13v03.dts | 16 ++++++++--------
 drivers/regulator/tps549d22-regulator.c          |  2 +-
 2 files changed, 9 insertions(+), 9 deletions(-)

diff --git a/arch/riscv/boot/dts/eswin/eic7702-deepcomputing-fml13v03.dts b/arch/riscv/boot/dts/eswin/eic7702-deepcomputing-fml13v03.dts
index c6ce1a0113d2..1ced9cfcd2af 100644
--- a/arch/riscv/boot/dts/eswin/eic7702-deepcomputing-fml13v03.dts
+++ b/arch/riscv/boot/dts/eswin/eic7702-deepcomputing-fml13v03.dts
@@ -61,27 +61,27 @@ cpus {
 		timebase-frequency = <RTCCLK_FREQ>;
 	};
 
-	memory@59000000 {
+	memory@80000000 {
 		device_type = "memory";
-		reg = <0x0 0x59000000 0x0 0x400000>;
+		reg = <0x0 0x80000000 MEMORY_SIZE_H MEMORY_SIZE_L>;
 		numa-node-id = <0>;
 	};
 
-	memory@79000000 {
+	memory@2000000000 {
 		device_type = "memory";
-		reg = <0x0 0x79000000 0x0 0x400000>;
+		reg = <0x20 0x00000000 MEMORY_SIZE_H MEMORY_SIZE_L>;
 		numa-node-id = <1>;
 	};
 
-	memory@80000000 {
+	memory@59000000 {
 		device_type = "memory";
-		reg = <0x0 0x80000000 MEMORY_SIZE_H MEMORY_SIZE_L>;
+		reg = <0x0 0x59000000 0x0 0x400000>;
 		numa-node-id = <0>;
 	};
 
-	memory@2000000000 {
+	memory@79000000 {
 		device_type = "memory";
-		reg = <0x20 0x00000000 MEMORY_SIZE_H MEMORY_SIZE_L>;
+		reg = <0x0 0x79000000 0x0 0x400000>;
 		numa-node-id = <1>;
 	};
 
diff --git a/drivers/regulator/tps549d22-regulator.c b/drivers/regulator/tps549d22-regulator.c
index dd0052525c36..93684d917863 100644
--- a/drivers/regulator/tps549d22-regulator.c
+++ b/drivers/regulator/tps549d22-regulator.c
@@ -462,7 +462,7 @@ static s32 tps549d22_init_data(struct TPS549D22_DRIVER_DATA *data,
 			tps549d22_regulator_desc.n_voltages);
 
 	tps549d22_set_vout(data, default_voltage);
-	tps549d22_write_byte(data, TPS549D22_CMD_ON_OFF_CONFIG, 0xf);
+	tps549d22_write_byte(data, TPS549D22_CMD_ON_OFF_CONFIG, 0x7);
 	ret =  tps549d22_update_byte(data, TPS549D22_CMD_OPERATION,
 								 TPS549D22_MASK_OPERATION_ENABLE,
 								 TPS549D22_MASK_OPERATION_ENABLE);
-- 
2.52.0

